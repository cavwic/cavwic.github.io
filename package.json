{
  "name": "cavwic-home",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node --max-old-space-size=8192 ./node_modules/astro/bin/astro.mjs build --mode pages",
    "build:local": "astro build",
    "check:pages-capacity": "node scripts/check-pages-capacity.mjs",
    "check:ai-publication": "node scripts/check-ai-publication.mjs",
    "build:review": "astro build --mode review",
    "check": "astro check",
    "test:ai-delivery": "node scripts/test-ai-delivery.mjs",
    "package:ai-skills": "node scripts/package-ai-skills.mjs",
    "test:hand-retargeting": "node scripts/test-hand-retargeting.mjs",
    "test:hand-calibration": "node scripts/test-hand-calibration.mjs",
    "test:hand-runtime": "node scripts/test-hand-runtime.mjs",
    "test:hand-visual": "node scripts/test-hand-visual.mjs",
    "test:robotics-labs": "node scripts/test-robotics-labs.mjs",
    "build:robotics-labs": "node scripts/build-robotics-labs.mjs",
    "package:robotics-labs": "node scripts/package-robotics-labs.mjs",
    "prepare:hand-retargeting": "node scripts/prepare-hand-retargeting-assets.mjs",
    "audit": "node scripts/audit-content.mjs",
    "audit:repository": "node scripts/audit-repository.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check && npm run audit && node scripts/test-pages-publication.mjs && npm run test:ai-delivery && npm run test:robotics-labs && npm run build && npm run check:ai-publication && npm run check:pages-capacity && npm run check:links",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.31.0",
    "@mediapipe/tasks-vision": "1.1.0",
    "astro": "^7.2.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
