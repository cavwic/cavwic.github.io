---
import { ArrowUp, ChevronDown, GitBranch, Languages, Menu, Moon, Sun, X } from "@lucide/astro";
import Analytics from "../components/Analytics.astro";
import { industryPagePath, primaryIndustries } from "../data/industries";
import { getBasePath, getNavigation, githubUrl, localizePath, type Locale } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale?: Locale;
  alternatePath?: string;
  autoDetectLocale?: boolean;
}

const {
  locale = "zh",
  title = "CAVWIC",
  description = locale === "zh"
    ? "CAVWIC 的方案、文章、工具与 Skills 发布站。"
    : "CAVWIC publishes solutions, articles, tools, and reusable skills.",
  image = "/images/workbench-hero.webp",
  alternatePath: alternatePathProp,
  autoDetectLocale = false,
} = Astro.props;

const copy = locale === "zh"
  ? {
      skip: "跳到正文",
      home: "CAVWIC 首页",
      openNav: "打开导航",
      closeNav: "关闭导航",
      nav: "主导航",
      github: "打开 CAVWIC 的 GitHub",
      language: "Switch to English",
      dark: "切换为深色模式",
      light: "切换为浅色模式",
      top: "回到顶部",
      footer: "方案、文章、工具与可复用的 Skills。",
      about: "关于本站",
      privacy: "隐私说明",
    }
  : {
      skip: "Skip to content",
      home: "CAVWIC home",
      openNav: "Open navigation",
      closeNav: "Close navigation",
      nav: "Main navigation",
      github: "Open CAVWIC on GitHub",
      language: "切换到中文",
      dark: "Switch to dark mode",
      light: "Switch to light mode",
      top: "Back to top",
      footer: "Solutions, articles, tools, and reusable skills.",
      about: "About this site",
      privacy: "Privacy",
    };

const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
const basePath = getBasePath(currentPath);
const alternateLocale: Locale = locale === "zh" ? "en" : "zh";
const alternatePath = alternatePathProp ?? (locale === "zh" ? "/en/industries" : "/industries");
const navigation = getNavigation(locale);
const homePath = localizePath(locale, "/");
const aboutPath = localizePath(locale, "/about");
const privacyPath = localizePath(locale, "/privacy");
const industryNavActive = basePath.startsWith("/industries") || basePath.startsWith("/matrices") || basePath.startsWith("/companies") || basePath.startsWith("/glossary");
const industryMenu = locale === "zh"
  ? {
      label: "行业与资料",
      industries: "行业",
      resources: "资料",
      matrices: "全部产品矩阵",
      companies: "全部公司档案",
      glossary: "术语库",
      referenceCode: "REFERENCE",
    }
  : {
      label: "Industries and references",
      industries: "Industries",
      resources: "Reference library",
      matrices: "All product matrices",
      companies: "All company files",
      glossary: "Glossary",
      referenceCode: "REFERENCE",
    };
---

<!doctype html>
<html
  lang={locale === "zh" ? "zh-CN" : "en"}
  data-locale={locale}
  data-alternate-locale={alternateLocale}
  data-alternate-path={alternatePath}
  data-auto-detect-locale={autoDetectLocale ? "true" : "false"}
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f4ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-CN"} href={new URL(alternatePath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const root = document.documentElement;
          const analyticsKey = "cavwic-analytics-disabled";
          const currentUrl = new URL(location.href);
          const analyticsAction = currentUrl.searchParams.get("analytics");
          if (analyticsAction === "off") localStorage.setItem(analyticsKey, "true");
          if (analyticsAction === "on") localStorage.removeItem(analyticsKey);
          if (analyticsAction === "off" || analyticsAction === "on") {
            currentUrl.searchParams.delete("analytics");
            history.replaceState(null, "", `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`);
          }
          root.dataset.analyticsDisabled = String(localStorage.getItem(analyticsKey) === "true");
          const savedLocale = localStorage.getItem("cavwic-locale");
          const systemLocale = navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en";
          const preferredLocale = savedLocale === "zh" || savedLocale === "en" ? savedLocale : systemLocale;

          root.dataset.languagePreference = savedLocale ?? "system";
          if (root.dataset.autoDetectLocale === "true" && preferredLocale !== root.dataset.locale) {
            root.dataset.localeRedirect = "true";
            location.replace(`${root.dataset.alternatePath}${location.search}${location.hash}`);
            return;
          }

          const saved = localStorage.getItem("cavwic-theme");
          const darkSystem = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = saved === "dark" || saved === "light" ? saved : darkSystem ? "dark" : "light";
          root.dataset.theme = theme;
          root.dataset.themePreference = saved ?? "system";
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#181c1b" : "#f1f4ef");
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="site-header">
      <a class="brand" href={homePath} aria-label={copy.home}>
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>CAVWIC</span>
      </a>

      <button class="nav-toggle" type="button" aria-label={copy.openNav} aria-expanded="false" aria-controls="site-nav" data-open-label={copy.openNav} data-close-label={copy.closeNav}>
        <Menu class="menu-icon" size={20} stroke-width={1.8} />
        <X class="close-icon" size={20} stroke-width={1.8} />
      </button>

      <nav id="site-nav" class="site-nav" aria-label={copy.nav}>
        <div class="nav-pages">
          {navigation.map((item) => item.basePath === "/industries" ? (
            <div class="nav-dropdown">
              <a class:list={["nav-link", "nav-dropdown-trigger", { active: industryNavActive }]} href={item.href} aria-haspopup="true">
                {item.label}<ChevronDown size={14} stroke-width={1.8} aria-hidden="true" />
              </a>
              <div class="nav-dropdown-panel" aria-label={industryMenu.label}>
                <p>{industryMenu.industries}</p>
                <div class="nav-dropdown-links">
                  {primaryIndustries.map((industry) => (
                    <a href={industryPagePath(industry.id, locale)}>
                      <strong>{locale === "zh" ? industry.name : industry.englishName}</strong>
                      <span>{industry.code}</span>
                    </a>
                  ))}
                </div>
                <div class="nav-dropdown-resources">
                  <p>{industryMenu.resources}</p>
                  <a href={`${locale === "en" ? "/en" : ""}/matrices`}><strong>{industryMenu.matrices}</strong><span>{industryMenu.referenceCode}</span></a>
                  <a href={`${locale === "en" ? "/en" : ""}/companies`}><strong>{industryMenu.companies}</strong><span>{industryMenu.referenceCode}</span></a>
                  <a href={`${locale === "en" ? "/en" : ""}/glossary`}><strong>{industryMenu.glossary}</strong><span>{industryMenu.referenceCode}</span></a>
                </div>
              </div>
            </div>
          ) : (
            <a class:list={["nav-link", { active: item.basePath === "/" ? basePath === "/" : basePath.startsWith(item.basePath) }]} href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
        <div class="nav-utilities">
          <button class="utility-button theme-toggle" type="button" aria-label={copy.dark} aria-pressed="false" title={copy.dark} data-dark-label={copy.dark} data-light-label={copy.light}>
            <Moon class="theme-icon-moon" size={18} stroke-width={1.8} aria-hidden="true" />
            <Sun class="theme-icon-sun" size={18} stroke-width={1.8} aria-hidden="true" />
          </button>
          <a class="utility-button language-toggle" href={alternatePath} aria-label={copy.language} title={copy.language}>
            <Languages size={18} stroke-width={1.8} aria-hidden="true" />
            <span>{locale === "zh" ? "EN" : "中"}</span>
          </a>
          <a class="utility-button github-link" href={githubUrl} target="_blank" rel="noreferrer" aria-label={copy.github}>
            <GitBranch size={19} stroke-width={1.8} />
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <button class="back-to-top" type="button" aria-label={copy.top} title={copy.top} hidden>
      <ArrowUp size={21} stroke-width={1.8} aria-hidden="true" />
    </button>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href={homePath}>
          <span class="brand-mark" aria-hidden="true">C</span>
          <span>CAVWIC</span>
        </a>
        <p>{copy.footer}</p>
      </div>
      <div class="footer-links">
        <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href={aboutPath}>{copy.about}</a>
        <a href={privacyPath}>{copy.privacy}</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} CAVWIC</p>
    </footer>

    <script is:inline>
      const navToggle = document.querySelector(".nav-toggle");
      const siteNav = document.querySelector(".site-nav");
      const themeToggle = document.querySelector(".theme-toggle");
      const languageToggle = document.querySelector(".language-toggle");
      const backToTop = document.querySelector(".back-to-top");
      const themeMedia = window.matchMedia("(prefers-color-scheme: dark)");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      navToggle?.addEventListener("click", () => {
        const isOpen = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", String(!isOpen));
        navToggle.setAttribute("aria-label", isOpen ? navToggle.dataset.openLabel : navToggle.dataset.closeLabel);
        siteNav?.classList.toggle("open", !isOpen);
      });

      const applyTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        themeToggle?.setAttribute("aria-label", theme === "dark" ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel);
        themeToggle?.setAttribute("title", theme === "dark" ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel);
        themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#181c1b" : "#f1f4ef");
      };

      applyTheme(document.documentElement.dataset.theme);

      themeToggle?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.themePreference = nextTheme;
        try { localStorage.setItem("cavwic-theme", nextTheme); } catch {}
        applyTheme(nextTheme);
      });

      themeMedia.addEventListener("change", (event) => {
        if (document.documentElement.dataset.themePreference === "system") {
          applyTheme(event.matches ? "dark" : "light");
        }
      });

      languageToggle?.addEventListener("click", () => {
        const nextLocale = document.documentElement.dataset.alternateLocale;
        document.documentElement.dataset.languagePreference = nextLocale;
        try { localStorage.setItem("cavwic-locale", nextLocale); } catch {}
      });

      const updateBackToTop = () => {
        backToTop?.toggleAttribute("hidden", window.scrollY < 480);
      };

      backToTop?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
      });

      window.addEventListener("scroll", updateBackToTop, { passive: true });
      updateBackToTop();
    </script>
    <Analytics />
  </body>
</html>
