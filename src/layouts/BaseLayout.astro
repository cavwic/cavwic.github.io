---
import { GitBranch, Menu, X } from "@lucide/astro";
import { githubUrl, navigation } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "CAVWIC | 方案、文章与工具",
  description = "CAVWIC 的方案、文章、工具与 Skills 发布站。",
  image = "/images/workbench-hero.webp",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161b1a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="CAVWIC 首页">
        <span class="brand-mark" aria-hidden="true">C</span>
        <span>CAVWIC</span>
      </a>

      <button class="nav-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="site-nav">
        <Menu class="menu-icon" size={20} strokeWidth={1.8} />
        <X class="close-icon" size={20} strokeWidth={1.8} />
      </button>

      <nav id="site-nav" class="site-nav" aria-label="主导航">
        {navigation.map((item) => (
          <a class:list={["nav-link", { active: item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))}
        <a class="github-link" href={githubUrl} target="_blank" rel="noreferrer" aria-label="打开 CAVWIC 的 GitHub">
          <GitBranch size={19} strokeWidth={1.8} />
        </a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/">
          <span class="brand-mark" aria-hidden="true">C</span>
          <span>CAVWIC</span>
        </a>
        <p>方案、文章、工具与可复用的 Skills。</p>
      </div>
      <div class="footer-links">
        <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
        <a href="/about">关于本站</a>
      </div>
      <p class="copyright">© {new Date().getFullYear()} CAVWIC</p>
    </footer>

    <script>
      const toggle = document.querySelector(".nav-toggle");
      const nav = document.querySelector(".site-nav");

      toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.setAttribute("aria-label", isOpen ? "打开导航" : "关闭导航");
        nav?.classList.toggle("open", !isOpen);
      });

    </script>
  </body>
</html>
