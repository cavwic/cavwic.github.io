---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    status?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} | CAVWIC`} description={frontmatter.description}>
  <article class="article-shell">
    <header class="article-head">
      <a class="back-link" href="/articles"><ArrowLeft size={17} />返回文章</a>
      <div class="article-meta">
        <span>{frontmatter.status ?? "已发布"}</span>
        <time>{frontmatter.date}</time>
      </div>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
