---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    status?: string;
    locale?: "zh" | "en";
  };
}

const { frontmatter } = Astro.props;
const locale = frontmatter.locale ?? "zh";
const alternatePath = locale === "zh" ? `/en${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, "") || "/";
const copy = locale === "zh"
  ? { back: "返回文章", published: "已发布" }
  : { back: "Back to articles", published: "Published" };
---

<BaseLayout title={`${frontmatter.title} | CAVWIC`} description={frontmatter.description} locale={locale} alternatePath={alternatePath}>
  <article class="article-shell">
    <header class="article-head">
      <a class="back-link" href={locale === "zh" ? "/articles" : "/en/articles"}><ArrowLeft size={17} />{copy.back}</a>
      <div class="article-meta">
        <span>{frontmatter.status ?? copy.published}</span>
        <time>{frontmatter.date}</time>
      </div>
      <h1>{frontmatter.title}</h1>
      <p>{frontmatter.description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
