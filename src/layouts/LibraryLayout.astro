---
import { ArrowLeft, ExternalLink, ShieldCheck } from "@lucide/astro";
import { evidenceLabels, kindLabels, industryLabels } from "../data/content";
import type { LibraryEntry, SourceRef } from "../data/content";
import { localizeSource } from "../data/source-localization";
import { sourcesById } from "../data/sources";
import BaseLayout from "./BaseLayout.astro";

const { entry } = Astro.props as { entry: LibraryEntry };
const locale = entry.data.locale;
const refs = entry.data.sourceIds
  .map((id: string) => sourcesById.get(id))
  .filter((ref): ref is SourceRef => Boolean(ref));
const localizedRefs = refs.map((ref) => localizeSource(ref, locale));
---

<BaseLayout
  title={`${entry.data.title} | CAVWIC`}
  description={entry.data.description}
  locale={entry.data.locale}
  alternatePath={entry.data.alternatePath ?? (entry.data.locale === "zh" ? "/en/industries" : "/industries")}
>
  <article class="library-article">
    <header class="library-head">
      <a class="text-link back-link" href={entry.data.locale === "zh" ? "/industries" : "/en/industries"}>
        <ArrowLeft size={18} /> {entry.data.locale === "zh" ? "返回资料库" : "Back to library"}
      </a>
      <div class="library-meta">
        <span>{kindLabels[locale][entry.data.kind]}</span>
        <span>{industryLabels[locale][entry.data.industry]}</span>
        <span class:list={["status", `status-${entry.data.publicationStatus}`]}>{locale === "zh" ? (entry.data.publicationStatus === "draft" ? "本地草稿" : "已发布") : (entry.data.publicationStatus === "draft" ? "Local draft" : "Published")}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <div class="evidence-strip" aria-label={locale === "zh" ? "证据类型" : "Evidence type"}>
        {entry.data.evidence.map((item) => <span>{evidenceLabels[locale][item]}</span>)}
      </div>
    </header>

    <div class="library-body prose">
      <slot />
    </div>

    <footer class="source-panel">
      <div class="source-panel-head">
        <div>
          <p class="eyebrow">SOURCE TRACE</p>
          <h2>{entry.data.locale === "zh" ? "资料来源" : "Sources"}</h2>
        </div>
      </div>
      {localizedRefs.length > 0 ? (
        <ol class="source-list">
          {localizedRefs.map((ref) => (
            <li id={ref.id}>
              <span>{ref.sourceType}</span>
              <a href={ref.url} target="_blank" rel="noreferrer">{ref.title} <ExternalLink size={14} /></a>
              <small>{ref.publisher}</small>
            </li>
          ))}
        </ol>
      ) : (
        <p class="source-empty"><ShieldCheck size={18} /> {entry.data.locale === "zh" ? "本页仅介绍已脱敏的个人工作方法，不含外部产品参数。" : "This page contains a redacted account of personal working methods."}</p>
      )}
    </footer>
  </article>
</BaseLayout>
