---
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { matrices } from "../../data/catalog";
import { industryLabels } from "../../data/content";
---
<BaseLayout title="产品矩阵 | CAVWIC" description="企业 AI、具身机器人与灵巧手的场景化产品比较矩阵。" alternatePath="/en/industries">
  <header class="page-head"><div class="page-head-inner"><p class="eyebrow">PRODUCT MATRICES / {String(matrices.length).padStart(2, "0")}</p><h1>产品矩阵</h1><p>按可比较的产品类型分别整理整机、模型与计算、感知、关节驱动、灵巧手和触觉力觉。矩阵用于缩小验证范围，不代替样机测试和厂商询证。</p></div></header>
  <section class="profile-grid">{matrices.map((matrix, index) => <a class="profile-row" href={`/matrices/${matrix.slug}`}><span class="profile-index">{String(index + 1).padStart(2, "0")}</span><div><p class="eyebrow">{industryLabels[matrix.industry]}</p><h2>{matrix.title}</h2><p>{matrix.description}</p></div><ArrowUpRight size={20} /></a>)}</section>
</BaseLayout>
