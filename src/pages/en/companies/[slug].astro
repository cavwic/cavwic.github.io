---
import CompanyProfilePage from "../../../components/CompanyProfilePage.astro";
import { getCompanies } from "../../../data/catalog-localization";
import { localizeSource } from "../../../data/source-localization";
import { sourcesById } from "../../../data/sources";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getCompanies("en").map((company) => ({ params: { slug: company.slug }, props: { company } }));
}
const { company } = Astro.props;
const refs = company.sourceIds.flatMap((id: string) => {
  const ref = sourcesById.get(id);
  return ref ? [localizeSource(ref, "en")] : [];
});
---

<BaseLayout locale="en" title={`${company.name} | Company File | CAVWIC`} description={company.positioning} alternatePath={`/companies/${company.slug}`}>
  <CompanyProfilePage company={company} locale="en" refs={refs} />
</BaseLayout>
