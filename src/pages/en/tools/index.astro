---
import CollectionPage from "../../../components/CollectionPage.astro";
import { isPagesBuild } from "../../../data/build-scope";
import { presalesPlatform } from "../../../data/site";
import { siteFeatures } from "../../../data/site-features";
const labUrl = import.meta.env.DEV ? "http://127.0.0.1:43202/cavwic-solutions-lab" : "https://cavwic.github.io/cavwic-solutions-lab";
const entries = [
  // Retained behind the switch for a future workbench revision.
  ...(siteFeatures.aiDeliveryWorkbench ? [{ title: "AI delivery workbench", description: "Define scope, approvals and acceptance for enterprise AI, workflows and AI-assisted coding. Export briefs and handoff prompts on your device, without model calls.", status: "published" as const, href: "/en/tools/ai-delivery-workbench", external: false }] : []),
  { title: "Dexterous Manipulation Labs", description: "Eight software experiments covering control, hand motion retargeting, safety, contact grasping, slip detection, data diagnostics, imitation learning and simulation robustness.", status: "published" as const, href: "/en/tools/robotics-lab", external: false },
  ...(!isPagesBuild ? [{ title: "Jeeling", description: "A robot and dexterous-hand research repository for companies, models, component metrics, funding, and policy sources.", status: "building" as const, href: "/en/tools/product-finder-demo", external: true }] : []),
  { ...presalesPlatform.en, href: labUrl, external: !import.meta.env.DEV },
];
---

<CollectionPage
  eyebrow="TOOLS"
  title="Tools"
  intro={siteFeatures.aiDeliveryWorkbench ? "AI delivery, robotics software experiments and the Presales Solution Platform." : "Robotics software experiments and the Presales Solution Platform."}
  entries={entries}
  locale="en"
  showMeta={false}
/>
