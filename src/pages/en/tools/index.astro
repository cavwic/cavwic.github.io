---
import CollectionPage from "../../../components/CollectionPage.astro";
const labUrl = import.meta.env.DEV ? "http://127.0.0.1:4322/cavwic-solutions-lab" : "https://cavwic.github.io/cavwic-solutions-lab";
const entries = [
  { title: "Solution Project Workbench", description: "Manage presales communication, tender analysis, and bid document preparation with a local workspace, model generation, and Codex task output.", status: "published" as const, href: labUrl, external: !import.meta.env.DEV, action: "Open workbench" },
];
---

<CollectionPage
  eyebrow="TOOLS"
  title="Tools"
  intro="The Solution Project Workbench is the only tool currently published. Project materials are processed in the browser and user-authorized local folders."
  entries={entries}
  locale="en"
/>
