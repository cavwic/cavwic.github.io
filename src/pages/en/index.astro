---
import { ArrowDown, ArrowUpRight, Blocks, ClipboardCheck, FileSearch, Route } from "@lucide/astro";
import ResumeLink from "../../components/ResumeLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout locale="en" title="Chen Wencong | AI · Embodied Robotics · Dexterous Hands" description="Presales solutions for enterprise AI, embodied robotics, and dexterous-hand validation." autoDetectLocale={true} alternatePath="/">
  <section class="hero professional-hero"><img src="/images/workbench-hero.webp" alt="A technical workbench with code, drawings, calipers, and a robotic hand assembly" fetchpriority="high"/><div class="hero-shade"></div><div class="hero-content"><p class="hero-kicker">PRESALES / SOLUTIONS / INDUSTRY RESEARCH</p><h1>Chen Wencong</h1><p class="hero-role">AI · Embodied Robotics · Dexterous Hands</p><p class="hero-summary">I translate business problems into system boundaries, POC evidence, and deliverable technical plans.</p><div class="hero-actions"><a class="button button-primary" href="#evidence">Evidence chain <ArrowDown size={18}/></a><ResumeLink className="button button-quiet" locale="en"/></div></div><p class="hero-index">DISCOVERY / ARCHITECTURE / POC / DELIVERY</p></section>
  <section id="evidence" class="evidence-section"><div class="section-heading"><div><p class="eyebrow">EVIDENCE CHAIN</p><h2>A presales process that survives the demo</h2></div><p>Six-plus years in complex B2B hardware and software presales, now applied to enterprise AI, embodied robotics, and dexterous-hand systems.</p></div><div class="capability-rail"><article><FileSearch size={22}/><span>01</span><h3>Discovery</h3><p>Process, data, site conditions, decision owners, and non-negotiable limits.</p></article><article><Blocks size={22}/><span>02</span><h3>Architecture</h3><p>System layers, interfaces, access control, dependencies, and alternatives.</p></article><article><ClipboardCheck size={22}/><span>03</span><h3>POC</h3><p>Samples, metrics, failure scripts, and acceptance owners before building.</p></article><article><Route size={22}/><span>04</span><h3>Delivery</h3><p>Deployment, training, version coordination, escalation, and handover.</p></article></div></section>
  <section class="deliverable-band"><div class="section-heading"><div><p class="eyebrow">CORE ENGLISH SUMMARY</p><h2>Research that starts with verification</h2></div><p>Detailed working papers are maintained in Chinese. English pages carry the positioning, methods, and core industry conclusions.</p></div><div class="deliverable-grid"><a href="/en/industries#ai"><span>01 / AI</span><h3>Enterprise AI</h3><p>RAG and agents are evaluated as operating systems, not chat-window demos.</p><ArrowUpRight size={18}/></a><a href="/en/industries#robotics"><span>02 / ROBOTICS</span><h3>Embodied robotics</h3><p>A credible proposal includes site conditions, failure recovery, safety, and service.</p><ArrowUpRight size={18}/></a><a href="/en/industries#dexterous-hands"><span>03 / HANDS</span><h3>Dexterous hands</h3><p>Selection starts from objects, contacts, interfaces, and test evidence, not DoF alone.</p><ArrowUpRight size={18}/></a></div></section>
</BaseLayout>
