---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout locale="en" title="Page not found | CAVWIC" description="This page could not be found.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Nothing here yet.</h1>
    <p>The link may have changed, or the page may still be in progress.</p>
    <a class="button button-primary" href="/en"><ArrowLeft size={18} />Back to home</a>
  </section>
</BaseLayout>
