---
import { ArrowLeft } from "@lucide/astro";
import { getMatrices } from "../../../data/catalog-localization";
import { industryMatrixPath, type PrimaryIndustryId } from "../../../data/industries";
import { localizeSource } from "../../../data/source-localization";
import { sourcesById } from "../../../data/sources";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return getMatrices("en").map((matrix) => ({ params: { slug: matrix.slug }, props: { matrix } }));
}
const { matrix } = Astro.props;
---

<BaseLayout locale="en" title={`${matrix.title} | CAVWIC`} description={matrix.description} alternatePath={`/matrices/${matrix.slug}`}>
  <article class="matrix-shell">
    <header class="detail-head"><a class="text-link back-link" href={industryMatrixPath(matrix.industry as PrimaryIndustryId, "en")}><ArrowLeft size={18} /> Back to this industry's matrices</a><p class="eyebrow">COMPARISON MATRIX / VERIFIED {matrix.reviewedAt}</p><h1>{matrix.title}</h1><p>{matrix.description}</p></header>
    <div class="dimension-strip">{matrix.dimensions.map((item: string, index: number) => <span><b>{String(index + 1).padStart(2, "0")}</b>{item}</span>)}</div>
    <div class="matrix-table-wrap"><table class="matrix-table"><thead><tr><th>Product</th><th>Company</th><th>Type</th><th>Public access</th><th>Integration</th><th>Verification focus</th><th>Sources</th></tr></thead><tbody>{matrix.rows.map((row) => <tr><th>{row.product}</th><td>{row.company}</td><td>{row.type}</td><td>{row.openness}</td><td>{row.integration}</td><td>{row.verificationFocus}</td><td>{row.sourceIds.map((id: string) => { const ref = sourcesById.get(id); const label = ref ? localizeSource(ref, "en").title : id; return <a href={ref?.url} target="_blank" rel="noreferrer" aria-label={label}>[{id}]</a>; })}</td></tr>)}</tbody></table></div>
    <p class="matrix-note">Fields not found in public material remain "Not public" or "Confirm with vendor." There is no overall score. Selection must return to the task, site, safety, and maintenance conditions.</p>
  </article>
</BaseLayout>
