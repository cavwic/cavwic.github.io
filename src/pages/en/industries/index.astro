---
import IndustryDirectoryNav from "../../../components/IndustryDirectoryNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout locale="en" title="Industry Research | CAVWIC" description="Core English summaries for enterprise AI, embodied robotics, and dexterous hands." alternatePath="/industries">
  <header class="page-head"><div class="page-head-inner"><p class="eyebrow">INDUSTRY RESEARCH</p><h1>Three fields, one delivery discipline</h1><p>The primary research library is maintained in Chinese. These summaries state the decision framework and the evidence still required.</p></div></header>
  <IndustryDirectoryNav locale="en" />
</BaseLayout>

<script is:inline>
  const legacyIndustry = location.hash.slice(1);
  if (["ai", "robotics", "dexterous-hands"].includes(legacyIndustry)) {
    location.replace(`/en/industries/${legacyIndustry}`);
  }
</script>
