---
import { ArrowDown } from "@lucide/astro";
import EntryList from "../../../components/EntryList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { industries } from "../../../data/site";

const industryList = industries.en;
---

<BaseLayout locale="en" title="Industries | CAVWIC" description="Industry notes organized around AI, robotics, and dexterous hands.">
  <header class="page-head">
    <div class="page-head-inner">
      <p class="eyebrow">INDUSTRIES</p>
      <h1>Industries</h1>
      <p>Long-running notes on technologies, products, and solution work, organized by field.</p>
    </div>
  </header>

  <nav class="industry-directory" aria-label="Industry categories">
    <div class="industry-directory-inner">
      {industryList.map((industry) => (
        <a class="industry-tab" href={`#${industry.id}`}>
          <span>{industry.code}</span>
          <strong>{industry.name}</strong>
          <ArrowDown size={18} strokeWidth={1.8} aria-hidden="true" />
        </a>
      ))}
    </div>
  </nav>

  <div class="industries-content">
    {industryList.map((industry) => (
      <section id={industry.id} class="industry-section" aria-labelledby={`${industry.id}-title`}>
        <div class="industry-section-head">
          <div>
            <p class="eyebrow">{industry.code}</p>
            <h2 id={`${industry.id}-title`}>{industry.name}</h2>
          </div>
          <p>{industry.description}</p>
        </div>
        <EntryList entries={industry.entries} locale="en" />
      </section>
    ))}
  </div>
</BaseLayout>
