---
import IndustryDirectoryNav from "../../../components/IndustryDirectoryNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout locale="en" title="Industry Library | CAVWIC" description="White papers, product matrices, company files, articles, cases, and terminology for enterprise AI, embodied robotics, and dexterous hands." alternatePath="/industries">
  <header class="page-head"><div class="page-head-inner"><p class="eyebrow">INDUSTRY LIBRARY</p><h1>Three fields, one delivery discipline</h1><p>Facts, practice, and analysis are labeled separately. Product conclusions retain their sources, review dates, and open verification questions.</p></div></header>
  <IndustryDirectoryNav locale="en" />
</BaseLayout>

<script is:inline>
  const legacyIndustry = location.hash.slice(1);
  if (["ai", "robotics", "dexterous-hands"].includes(legacyIndustry)) {
    location.replace(`/en/industries/${legacyIndustry}`);
  }
</script>
