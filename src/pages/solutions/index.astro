---
import { getCollection } from "astro:content";
import CollectionPage from "../../components/CollectionPage.astro";
import { isVisible, toEntry } from "../../data/content";
const entries = (await getCollection("library"))
  .filter((entry) => entry.data.locale === "zh" && ["whitepaper", "case-study"].includes(entry.data.kind) && isVisible(entry))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionPage eyebrow="SOLUTIONS" title="方案" intro="白皮书介绍方法，案例说明项目边界和交付过程。真实经历与个人实践分开标注。" entries={entries.map((entry) => toEntry(entry))} locale="zh" showMeta={false} />
