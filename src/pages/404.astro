---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在 | CAVWIC" description="找不到这个页面。">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>这里还没有内容。</h1>
    <p>链接可能已经调整，或者页面仍在整理。</p>
    <a class="button button-primary" href="/"><ArrowLeft size={18} />返回首页</a>
  </section>
</BaseLayout>
