---
import { getCollection, render } from "astro:content";
import LibraryLayout from "../../layouts/LibraryLayout.astro";
import { isVisible } from "../../data/content";

export async function getStaticPaths() {
  const entries = (await getCollection("library")).filter((entry) => entry.data.locale === "zh" && isVisible(entry));
  return entries.map((entry) => ({ params: { slug: entry.id.replace(/\.mdx?$/, "") }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<LibraryLayout entry={entry}>
  <Content />
</LibraryLayout>
