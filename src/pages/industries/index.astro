---
import IndustryDirectoryNav from "../../components/IndustryDirectoryNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="行业资料库 | CAVWIC" description="企业 AI、具身智能与灵巧手的白皮书、产品矩阵、公司档案、文章和案例。" alternatePath="/en/industries">
  <header class="page-head"><div class="page-head-inner"><p class="eyebrow">INDUSTRY LIBRARY</p><h1>行业资料库</h1><p>事实、实践和判断分开标注。所有产品相关结论均注明来源、公开口径和待验证条件。</p></div></header>
  <IndustryDirectoryNav />
</BaseLayout>

<script is:inline>
  const legacyIndustry = location.hash.slice(1);
  if (["ai", "robotics", "dexterous-hands"].includes(legacyIndustry)) {
    location.replace(`/industries/${legacyIndustry}`);
  }
</script>
