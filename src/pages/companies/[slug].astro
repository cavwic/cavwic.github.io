---
import CompanyProfilePage from "../../components/CompanyProfilePage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies } from "../../data/catalog";
import { sourcesById } from "../../data/sources";

export function getStaticPaths() {
  return companies.map((company) => ({ params: { slug: company.slug }, props: { company } }));
}
const { company } = Astro.props;
const refs = company.sourceIds.flatMap((id: string) => {
  const ref = sourcesById.get(id);
  return ref ? [ref] : [];
});
---

<BaseLayout title={`${company.name} | 公司档案 | CAVWIC`} description={company.positioning} alternatePath={`/en/companies/${company.slug}`}>
  <CompanyProfilePage company={company} locale="zh" refs={refs} />
</BaseLayout>
