---
import { ArrowUpRight } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { companies } from "../../data/catalog";
import { industryLabels } from "../../data/content";
const groups = (["ai", "robotics", "dexterous-hands"] as const).map((industry) => ({
  industry,
  companies: companies.filter((company) => company.industry === industry),
}));
---

<BaseLayout title="公司档案 | CAVWIC" description="企业 AI、具身机器人与灵巧手公司的公开资料档案。" alternatePath="/en/industries">
  <header class="page-head"><div class="page-head-inner"><p class="eyebrow">COMPANY FILES / {String(companies.length).padStart(2, "0")}</p><h1>公司档案</h1><p>按产业位置整理公开产品、擅长方向、适用场景和选型核验项。未公开的参数仍保留为待询证。</p></div></header>
  <div class="company-catalog" aria-label="公司档案">
    {groups.map((group) => (
      <section class="company-group">
        <header class="company-group-head">
          <p class="eyebrow">{group.industry.toUpperCase()} / {String(group.companies.length).padStart(2, "0")}</p>
          <h2>{industryLabels[group.industry]}</h2>
        </header>
        <div class="profile-grid">
          {group.companies.map((company) => (
            <a class="profile-row" href={`/companies/${company.slug}`}>
              <span class="profile-index">{String(companies.indexOf(company) + 1).padStart(2, "0")}</span>
              <div><p class="eyebrow">{company.valueChainRole ?? industryLabels[company.industry]}</p><h3>{company.name}</h3><p>{company.positioning}</p></div>
              <ArrowUpRight size={20} />
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
