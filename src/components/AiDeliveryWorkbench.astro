---
import { ArrowDown, ArrowUp, Beaker, BriefcaseBusiness, CheckCheck, CodeXml, Copy, Download, FileDown, FolderOpen, GitBranch, Plus, RotateCcw, Save, Trash2, Upload } from "@lucide/astro";
import { kindNames, modeNames, type Locale } from "../features/ai-delivery/model";
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === "zh";
const c = zh ? {
  title: "AI 交付工作台", intro: "从任务边界开始，整理可交接的方案。", example: "载入本模式示例", save: "保存本机草稿", load: "打开本机草稿", import: "导入任务 JSON", reset: "清空本模式", export: "导出任务 JSON", markdown: "下载任务书", copy: "复制当前内容", task: "任务定义", name: "任务名称", objective: "业务目标", data: "输入与授权", output: "交付结果", owner: "负责人", acceptance: "验收方法", recovery: "失败与恢复", excluded: "不在范围内", more: "范围与数据", sensitive: "涉及敏感资料", external: "使用外部模型或服务", steps: "执行步骤", add: "新增步骤", step: "步骤名称", kind: "处理方式", approval: "执行前审批", up: "上移步骤", down: "下移步骤", remove: "删除步骤", plan: "任务书", checks: "检查清单", prompt: "交接提示词", gaps: "待补", reviews: "待核对", note: "仅在本机整理；不上传任务，不调用模型。", skill: "配套 Skill", placeholder: "例如：维修知识助手 POC", objectiveHint: "谁需要完成什么动作，期望改变什么？", acceptanceHint: "列出样本、预期结果、失败条件和验证方式。", dataHint: "来源、版本、授权角色；勿填写密钥或个人敏感原文。", preview: "交付预览", initial: "填写左侧任务，预览会同步更新。",
} : {
  title: "AI delivery workbench", intro: "Define the boundary. Prepare a useful handoff.", example: "Load example for this mode", save: "Save draft on this device", load: "Open saved draft", import: "Import task JSON", reset: "Clear this mode", export: "Export task JSON", markdown: "Download brief", copy: "Copy current content", task: "Task definition", name: "Task name", objective: "Objective", data: "Input and authorization", output: "Deliverable", owner: "Owner", acceptance: "Acceptance method", recovery: "Failure and recovery", excluded: "Out of scope", more: "Scope and data", sensitive: "Sensitive input", external: "External model or service", steps: "Planned steps", add: "Add step", step: "Step name", kind: "Step type", approval: "Approval required", up: "Move step up", down: "Move step down", remove: "Delete step", plan: "Brief", checks: "Checklist", prompt: "Handoff prompt", gaps: "Missing", reviews: "Review", note: "Task data stays on this device. No model calls.", skill: "Companion Skill", placeholder: "For example: maintenance knowledge pilot", objectiveHint: "Who needs to do what, and what should change?", acceptanceHint: "Define samples, expected outcomes, failure conditions and checks.", dataHint: "Sources, versions and authorized roles; no secrets or raw sensitive data.", preview: "Delivery preview", initial: "Define the task to update the brief.",
};
const icons = { enterprise: BriefcaseBusiness, workflow: GitBranch, coding: CodeXml };
---
<div class="ai-workbench" data-ai-workbench data-locale={locale}>
  <header class="ai-heading"><div><p class="eyebrow">AI DELIVERY / LOCAL</p><h1>{c.title}</h1><p>{c.intro}</p></div><p class="ai-privacy"><CheckCheck size={18} />{c.note}</p></header>
  <div class="ai-command-bar">
    <div class="ai-modes" role="group" aria-label={zh ? "任务类型" : "Task type"}>
      {(["enterprise", "workflow", "coding"] as const).map(mode => { const Icon = icons[mode]; return <button type="button" data-mode={mode} aria-pressed="false"><Icon size={20} /><span>{modeNames[locale][mode]}</span></button>; })}
    </div>
    <div class="ai-actions">
      <button type="button" data-action="example" title={c.example} aria-label={c.example}><Beaker size={20} /></button>
      <button type="button" data-action="save" title={c.save} aria-label={c.save}><Save size={20} /></button>
      <button type="button" data-action="load" title={c.load} aria-label={c.load}><FolderOpen size={20} /></button>
      <button type="button" data-action="import" title={c.import} aria-label={c.import}><Upload size={20} /></button>
      <button type="button" data-action="json" title={c.export} aria-label={c.export}><FileDown size={20} /></button>
      <button type="button" data-action="reset" title={c.reset} aria-label={c.reset}><RotateCcw size={20} /></button>
      <input type="file" accept="application/json,.json" data-import-file hidden />
    </div>
  </div>
  <p class="ai-status" role="status" aria-live="polite" data-status></p>
  <div class="ai-workspace">
    <form class="ai-editor" autocomplete="off">
      <section><h2>{c.task}</h2><div class="ai-fields">
        <label class="ai-wide">{c.name}<input name="title" maxlength="120" placeholder={c.placeholder} /></label>
        <label class="ai-wide">{c.objective}<textarea name="objective" rows="2" maxlength="12000" placeholder={c.objectiveHint}></textarea></label>
        <label>{c.data}<textarea name="data" rows="3" maxlength="12000" placeholder={c.dataHint}></textarea></label>
        <label>{c.output}<textarea name="output" rows="3" maxlength="12000"></textarea></label>
        <label class="ai-wide">{c.owner}<input name="owner" maxlength="500" /></label>
        <label>{c.acceptance}<textarea name="acceptance" rows="4" maxlength="12000" placeholder={c.acceptanceHint}></textarea></label>
        <label>{c.recovery}<textarea name="recovery" rows="4" maxlength="12000"></textarea></label>
      </div></section>
      <details class="ai-boundaries"><summary>{c.more}</summary><label>{c.excluded}<textarea name="excluded" rows="2" maxlength="12000"></textarea></label><div class="ai-flags"><label><input type="checkbox" name="sensitive" />{c.sensitive}</label><label><input type="checkbox" name="external" />{c.external}</label></div></details>
      <section class="ai-step-section"><div class="ai-section-head"><h2>{c.steps}</h2><button type="button" data-action="add" title={c.add} aria-label={c.add}><Plus size={20} /></button></div><ol class="ai-steps" data-steps></ol></section>
    </form>
    <aside class="ai-preview" aria-label={c.preview}>
      <div class="ai-preview-head"><div><span class="eyebrow">{c.preview}</span><h2 data-preview-title>{c.task}</h2></div><div class="ai-file-actions"><button type="button" data-action="copy" title={c.copy} aria-label={c.copy}><Copy size={20} /></button><button type="button" data-action="markdown" title={c.markdown} aria-label={c.markdown}><Download size={20} /></button></div></div>
      <div class="ai-counts" aria-live="polite"><span>{c.gaps} <strong data-gap-count>0</strong></span><span>{c.reviews} <strong data-review-count>0</strong></span><a data-skill-link href={`${zh ? "" : "/en"}/skills/enterprise-ai-delivery`}>{c.skill} ↗</a></div>
      <div class="ai-preview-tabs" role="tablist" aria-label={c.preview}>{(["plan", "checks", "prompt"] as const).map((format, index) => <button type="button" role="tab" id={`ai-tab-${format}`} aria-controls="ai-preview-content" aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-format={format}>{c[format]}</button>)}</div>
      <pre id="ai-preview-content" class="ai-preview-content" role="tabpanel" aria-labelledby="ai-tab-plan" tabindex="0" data-preview>{c.initial}</pre>
    </aside>
  </div>
  <template data-step-template><li class="ai-step"><span class="ai-step-index"></span><div class="ai-step-fields"><input data-step-name maxlength="300" aria-label={c.step} /><div class="ai-step-options"><select data-step-kind aria-label={c.kind}>{Object.entries(kindNames[locale]).map(([value, label]) => <option value={value}>{label}</option>)}</select><label><input type="checkbox" data-step-approval />{c.approval}</label></div></div><div class="ai-step-actions"><button type="button" data-step-action="up" aria-label={c.up} title={c.up}><ArrowUp size={16} /></button><button type="button" data-step-action="down" aria-label={c.down} title={c.down}><ArrowDown size={16} /></button><button type="button" data-step-action="remove" aria-label={c.remove} title={c.remove}><Trash2 size={16} /></button></div></li></template>
</div>
<script>
  import { initWorkbench } from "../features/ai-delivery/client";
  document.querySelectorAll<HTMLElement>("[data-ai-workbench]").forEach(initWorkbench);
</script>
<style is:global>
  .ai-workbench { width: min(1440px, calc(100% - 64px)); margin: 0 auto; padding: 34px 0 64px; font-size: 17px; }
  .ai-heading { display: flex; gap: 28px; justify-content: space-between; align-items: end; padding-bottom: 26px; }
  .ai-heading h1 { margin: 5px 0 6px; font-size: 34px; line-height: 1.25; }
  .ai-heading p { margin: 0; color: var(--ink-soft); }
  .ai-heading .eyebrow { color: var(--signal); font-size: 12px; }
  .ai-privacy { display: flex; gap: 8px; align-items: center; font-size: 14px; max-width: 340px; }
  .ai-privacy svg { flex-shrink: 0; color: var(--teal); }
  .ai-command-bar { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; border-block: 1px solid var(--line); padding: 15px 0; }
  .ai-workbench button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; min-height: 40px; min-width: 40px; padding: 8px; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: 4px; font: inherit; cursor: pointer; }
  .ai-workbench button:disabled { cursor: default; opacity: .38; }
  .ai-workbench button:hover:not(:disabled) { background: var(--paper-deep); border-color: var(--control-line); }
  .ai-workbench button[aria-pressed="true"] { color: var(--on-teal); background: var(--teal); border-color: var(--teal); }
  .ai-modes, .ai-actions, .ai-file-actions { display: flex; gap: 6px; align-items: center; }
  .ai-modes { align-items: stretch; }
  .ai-modes button { padding-inline: 16px; font-weight: 700; }
  .ai-status { min-height: 25px; margin: 8px 0; font-size: 14px; color: var(--teal); }
  .ai-status[data-error="true"] { color: var(--orange); }
  .ai-workspace { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 42px; align-items: start; }
  .ai-editor section { border-top: 2px solid var(--teal); padding: 18px 0 24px; }
  .ai-workbench h2 { margin: 0 0 18px; font-size: 22px; line-height: 1.4; }
  .ai-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .ai-workbench label { display: grid; gap: 7px; min-width: 0; font-size: 16px; font-weight: 600; }
  .ai-wide { grid-column: 1 / -1; }
  .ai-workbench :is(input:not([type="checkbox"]), textarea, select) { width: 100%; min-width: 0; background: var(--surface); color: var(--ink); border: 1px solid var(--control-line); border-radius: 3px; font: inherit; font-weight: 400; line-height: 1.6; padding: 10px 12px; }
  .ai-workbench textarea { resize: vertical; min-height: 80px; }
  .ai-workbench input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--teal); flex-shrink: 0; }
  .ai-boundaries { border-top: 1px solid var(--line); padding-block: 16px; }
  .ai-boundaries summary { cursor: pointer; font-weight: 700; margin-bottom: 12px; }
  .ai-flags { display: flex; flex-wrap: wrap; gap: 18px; padding-top: 15px; }
  .ai-flags label, .ai-step-options label { display: flex; align-items: center; gap: 7px; font-weight: 400; }
  .ai-section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .ai-section-head h2 { margin: 0; }
  .ai-steps { list-style: none; padding: 0; margin: 0; }
  .ai-step { display: grid; grid-template-columns: 27px minmax(0, 1fr) 32px; gap: 10px; border-bottom: 1px solid var(--line); padding-block: 13px; }
  .ai-step-index { color: var(--teal); font: 14px var(--mono); padding-top: 12px; }
  .ai-step-options { display: flex; align-items: center; gap: 12px; padding-top: 8px; }
  .ai-step-options select { max-width: 170px; padding-block: 6px; }
  .ai-step-options label { font-size: 14px; }
  .ai-step-actions { display: grid; gap: 3px; }
  .ai-step-actions button { min-width: 30px; min-height: 30px; height: 30px; padding: 4px; }
  .ai-preview { position: sticky; top: 88px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; min-width: 0; }
  .ai-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 24px 16px; }
  .ai-preview-head .eyebrow { font-size: 11px; color: var(--ink-soft); }
  .ai-preview-head h2 { margin: 4px 0 0; overflow-wrap: anywhere; font-size: 23px; }
  .ai-file-actions { flex-shrink: 0; }
  .ai-counts { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; padding: 0 24px 18px; font-size: 14px; color: var(--ink-soft); }
  .ai-counts strong { font: 700 18px var(--mono); color: var(--orange); padding-left: 4px; }
  .ai-counts a { margin-left: auto; color: var(--teal); text-decoration: underline; text-underline-offset: 4px; }
  .ai-preview-tabs { display: flex; border-block: 1px solid var(--line); padding: 0 18px; gap: 12px; background: var(--paper); }
  .ai-preview-tabs button { border: 0; border-bottom: 3px solid transparent; border-radius: 0; padding: 13px 5px; font-size: 15px; }
  .ai-preview-tabs button[aria-selected="true"] { color: var(--teal); border-bottom-color: var(--teal); font-weight: 700; }
  .ai-preview-content { margin: 0; padding: 24px; white-space: pre-wrap; overflow-wrap: anywhere; font: 16px/1.85 var(--body); height: min(65vh, 740px); min-height: 350px; overflow: auto; scrollbar-gutter: stable; }
  @media (max-width: 1050px) { .ai-workspace { gap: 24px; } .ai-heading { align-items: start; } .ai-privacy { max-width: 220px; } }
  @media (max-width: 820px) { .ai-workbench { width: calc(100% - 32px); padding-top: 24px; } .ai-workspace { grid-template-columns: minmax(0, 1fr); } .ai-preview { position: static; } .ai-privacy { display: none; } .ai-heading h1 { font-size: 30px; } .ai-modes { width: 100%; } .ai-modes button { flex: 1; padding: 10px 8px; font-size: 15px; min-height: 84px; } .ai-modes button span { line-height: 1.3; } .ai-modes svg { width: 17px; flex-shrink: 0; } .ai-command-bar { gap: 10px; } .ai-actions { margin-left: auto; } .ai-preview-content { height: 540px; } }
  @media (max-width: 460px) { .ai-fields { grid-template-columns: minmax(0, 1fr); } .ai-modes button { flex-direction: column; font-size: 14px; } .ai-step-options { flex-wrap: wrap; gap: 5px; } .ai-preview-head { padding-inline: 16px; } .ai-counts { padding-inline: 16px; } .ai-preview-tabs { gap: 10px; padding-inline: 10px; } .ai-preview-content { padding: 16px; } }
</style>
