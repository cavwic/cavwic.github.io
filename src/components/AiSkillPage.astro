---
import { ArrowLeft, ArrowRight, Download, FileText, Play } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { aiSkills } from "../data/ai-delivery";
import { siteFeatures } from "../data/site-features";
import type { Locale } from "../data/site";
interface Props { slug: string; locale: Locale }
const { slug, locale } = Astro.props;
const skill = aiSkills.find(s => s.slug === slug)!;
const zh = locale === "zh";
const base = zh ? "" : "/en";
const fileBase = `/skills/${slug}/${locale}`;
const workbench = `${base}/tools/ai-delivery-workbench?mode=${skill.mode}&example=1`;
---
<BaseLayout title={`${skill.title[locale]} | CAVWIC`} description={skill.description[locale]} locale={locale} alternatePath={`${zh ? "/en" : ""}/skills/${slug}`}>
  <article class="article-shell ai-skill-page">
    <header class="article-head"><a class="back-link" href={`${base}/skills`}><ArrowLeft size={18} />{zh ? "返回 Skills" : "Back to Skills"}</a><p class="eyebrow">{skill.phase[locale]}</p><h1>{skill.title[locale]}</h1><p>{skill.description[locale]}</p></header>
    <div class="ai-skill-links">{siteFeatures.aiDeliveryWorkbench && <a href={workbench}><Play size={20} />{zh ? "载入此 Skill 示例" : "Open this Skill's example"}</a>}<a href={`${fileBase}/${slug}.zip`} download><Download size={20} />{zh ? "下载 Skill 包" : "Download Skill package"}</a><a href={`${fileBase}/SKILL.md`}><FileText size={20} />SKILL.md</a></div>
    <div class="prose">
      <section class="ai-skill-purpose"><h2>{skill.question[locale]}</h2><p>{skill.useWhen[locale]}</p></section>
      <div class="ai-skill-contract"><section><h2>{zh ? "需要提供" : "Bring these inputs"}</h2><ul>{skill.inputs[locale].map(p => <li>{p}</li>)}</ul></section><section><h2>{zh ? "应当交付" : "Expected deliverables"}</h2><ul>{skill.outputs[locale].map(p => <li>{p}</li>)}</ul></section></div>
      <ol class="ai-skill-sequence" aria-label={zh ? "处理顺序" : "Working sequence"}>{skill.sequence[locale].map((step, i) => <li><span>{String(i + 1).padStart(2, "0")}</span>{step}{i < skill.sequence[locale].length - 1 && <ArrowRight size={16} aria-hidden="true" />}</li>)}</ol>
      <section class="ai-skill-example"><h2>{zh ? "一个完整样例" : "A worked example"}</h2><h3>{zh ? "用户的请求" : "The request"}</h3><blockquote>{skill.request[locale]}</blockquote><h3>{zh ? "产出摘录" : "Expected response excerpts"}</h3><dl>{skill.example[locale].map(item => <div><dt>{item.title}</dt><dd>{item.detail}</dd></div>)}</dl><p class="ai-skill-note">{zh ? "虚构演练场景，不代表客户项目或已通过的实测。" : "A fictional design exercise, not a customer project or a passed test."}</p></section>
      <section class="ai-skill-boundary"><h2>{zh ? "不负责什么" : "Where this Skill stops"}</h2><p>{skill.boundary[locale]}</p></section>
      <section><h2>{zh ? "使用资料" : "Resources"}</h2><div class="ai-skill-resources"><a href={`${fileBase}/references/${skill.worksheet}`}><FileText size={18} />{zh ? "专项工作表" : "Focused worksheet"}</a><a href={`${fileBase}/references/example.md`}><FileText size={18} />{zh ? "完整演练样例" : "Full worked example"}</a><a href={`${fileBase}/brief.example.json`} download><Download size={18} />{zh ? "示例任务 JSON" : "Example task JSON"}</a></div>
        <pre><code>node scripts/validate-brief.mjs brief.example.json --locale {locale}</code></pre><p class="ai-skill-note">{zh ? "Node.js 22.6+；检查格式、所属模式与有限缺项，不执行任务，不代替真实审批、项目测试或安全审查。下载不会自动安装。" : "Node.js 22.6+. Checks format, task mode and limited gaps; does not execute tasks or replace approval, project tests or security review. Downloading does not install it."}</p>
      </section>
      <section><h2>{zh ? "延伸阅读" : "Read next"}</h2><p><a href={`${base}/library/${skill.article}`}>{zh ? "查看本 Skill 对应的文章" : "Read the focused article"}</a> · <a href={`${base}/library/${skill.solution}`}>{zh ? "完整方案" : "Full solution"}</a></p></section>
    </div>
  </article>
</BaseLayout>
<style>
  .ai-skill-links{display:flex;flex-wrap:wrap;gap:12px;width:min(900px,calc(100% - 48px));margin:0 auto;padding-top:24px}
  .ai-skill-links a{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 16px;border:1px solid var(--line);border-radius:4px;font-weight:700}
  .ai-skill-links a:first-child{color:var(--on-teal);background:var(--teal);border-color:var(--teal)}
  .ai-skill-links a:hover{outline:1px solid var(--control-line)}
  .ai-skill-page .article-head h1{font-size:42px}
  .ai-skill-page .prose{width:min(900px,calc(100% - 48px));padding-top:32px}
  .ai-skill-purpose{border-top:2px solid var(--teal);padding-top:8px}
  .ai-skill-page .ai-skill-purpose h2{margin-top:24px}
  .ai-skill-contract{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:35px;border-bottom:1px solid var(--line);padding-bottom:20px}
  .ai-skill-contract section{min-width:0}
  .ai-skill-page .ai-skill-sequence{list-style:none;padding:0;margin:28px 0 40px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
  .ai-skill-sequence li{position:relative;font-size:15px;line-height:1.5;padding-right:16px}
  .ai-skill-sequence li span{display:block;font-family:var(--mono);color:var(--teal);margin-bottom:9px}
  .ai-skill-sequence svg{position:absolute;right:0;top:28px}
  .ai-skill-example{border-block:1px solid var(--line);padding-bottom:20px}
  .ai-skill-example blockquote{font-size:18px;font-style:normal;border-left-color:var(--teal)}
  .ai-skill-example dl{margin:0}
  .ai-skill-example dl>div{display:grid;grid-template-columns:100px minmax(0,1fr);gap:20px;border-top:1px solid var(--line);padding:18px 0}
  .ai-skill-example dt{font-size:16px;font-weight:700;color:var(--teal)}
  .ai-skill-example dd{margin:0;font-size:17px;line-height:1.85}
  .ai-skill-page .ai-skill-note{font-size:14px;color:var(--ink-soft);line-height:1.8}
  .ai-skill-resources{display:flex;flex-wrap:wrap;gap:12px 24px}
  .ai-skill-resources a{display:inline-flex;align-items:center;gap:7px;font-size:16px}
  .ai-skill-page pre{max-width:100%;overflow-x:auto}
  @media(max-width:600px){.ai-skill-page .article-head h1{font-size:32px}.ai-skill-contract{grid-template-columns:minmax(0,1fr);gap:0}.ai-skill-page .ai-skill-sequence{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.ai-skill-example dl>div{grid-template-columns:minmax(0,1fr);gap:7px}.ai-skill-links a{font-size:15px;padding:10px 12px}}
</style>
