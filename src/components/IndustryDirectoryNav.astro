---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";
import { companies, matrices } from "../data/catalog";
import { industryCompanyPath, industryMatrixPath, industryPagePath, primaryIndustries, type PrimaryIndustryId } from "../data/industries";
import type { Locale } from "../data/site";

const { locale = "zh", currentIndustry } = Astro.props as { locale?: Locale; currentIndustry?: PrimaryIndustryId };
const copy = locale === "zh"
  ? {
      label: "行业与资料导航",
      industries: "行业",
      resources: "资料",
      matrices: "全部产品矩阵",
      companies: "全部公司档案",
      glossary: "术语库",
      industryMatrices: "产品矩阵",
      industryCompanies: "公司档案",
      items: "项",
    }
  : {
      label: "Industries and reference navigation",
      industries: "Industries",
      resources: "Reference library",
      matrices: "All product matrices",
      companies: "All company files",
      glossary: "Glossary",
      industryMatrices: "Product matrices",
      industryCompanies: "Company files",
      items: "ITEMS",
    };
---

<nav class:list={["industry-directory", { "industry-directory-index": !currentIndustry }]} aria-label={copy.label}>
  <div class="industry-directory-inner">
    <section class="directory-cluster directory-cluster-industries" aria-labelledby={`directory-industries-${locale}`}>
      <p id={`directory-industries-${locale}`} class="directory-cluster-label">{copy.industries}</p>
      <div class="directory-cluster-grid directory-industry-grid">
        {primaryIndustries.map((industry) => {
          const industryName = locale === "zh" ? industry.name : industry.englishName;
          const active = currentIndustry === industry.id;
          return (
            <div class:list={["industry-tab-group", { active }]}>
              <a class:list={["industry-tab", { active }]} href={industryPagePath(industry.id, locale)} aria-current={active ? "page" : undefined}>
                <strong>{industryName}</strong>
                <ArrowRight size={18} />
                <span>{industry.code}</span>
              </a>
              <div class="industry-tab-subnav" aria-label={`${industryName} ${copy.resources}`}>
                <a href={industryMatrixPath(industry.id, locale)} aria-label={`${industryName} ${copy.industryMatrices}`}>
                  <strong>{copy.industryMatrices}</strong>
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
                <a href={industryCompanyPath(industry.id, locale)} aria-label={`${industryName} ${copy.industryCompanies}`}>
                  <strong>{copy.industryCompanies}</strong>
                  <ArrowUpRight size={14} aria-hidden="true" />
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>
    <section class="directory-cluster directory-cluster-resources" aria-labelledby={`directory-resources-${locale}`}>
      <p id={`directory-resources-${locale}`} class="directory-cluster-label">{copy.resources}</p>
      <div class="directory-cluster-grid directory-resource-grid">
        <a class="industry-tab resource-tab" href={`${locale === "en" ? "/en" : ""}/matrices`}>
          <strong>{copy.matrices}</strong>
          <ArrowUpRight size={18} />
          <span>{String(matrices.length).padStart(2, "0")} {copy.items}</span>
        </a>
        <a class="industry-tab resource-tab" href={`${locale === "en" ? "/en" : ""}/companies`}>
          <strong>{copy.companies}</strong>
          <ArrowUpRight size={18} />
          <span>{String(companies.length).padStart(2, "0")} {copy.items}</span>
        </a>
        <a class="industry-tab resource-tab" href={`${locale === "en" ? "/en" : ""}/glossary`}>
          <strong>{copy.glossary}</strong>
          <ArrowUpRight size={18} />
          <span>120 {copy.items}</span>
        </a>
      </div>
    </section>
  </div>
</nav>
