  .filter-row select:disabled { color: var(--ink-soft); background: var(--paper); border-style: dashed; cursor: default; opacity: 1; }
  .filter-row select:focus { border-color: var(--teal); box-shadow: 0 0 0 2px color-mix(in srgb, var(--teal) 14%, transparent); }
  .technical-capabilities { display: grid; grid-template-columns: minmax(260px, .7fr) minmax(0, 2.3fr); gap: 10px; align-items: start; margin-top: 10px; }
