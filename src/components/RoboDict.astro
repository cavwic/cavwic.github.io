  .activity-feed h2 { margin: 5px 0 0; font-family: var(--display); font-size: 32px; }
  .activity-feed > header > p { max-width: 560px; margin: 0; color: var(--ink-soft); font-size: 14px; text-align: right; }
  .update-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
