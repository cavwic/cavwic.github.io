TS</p><h3>${escapeHtml(clientCopy.companyProducts)}</h3><div class="company-catalog-list">${products}</div></section><section class="company-detail-section" id="tool-company-business"><p class="section-code">03 / BUSINESS</p><h3>${escapeHtml(clientCopy.businessAreas)}</h3><div class="company-detail-columns"><div><h4>${escapeHtml(clientCopy.businessAreas)}</h4>${chips(profile.businessAreas || profile.strengths || [])}</div><div><h4>${escapeHtml(clientCopy.customerGroups)}</h4>${chips(profile.customerGroups || profile.fit || [])}</div></div></section><section class="company-detail-section" id="tool-company-timeline"><p class="section-code">04 / TIMELINE</p><h3>${escapeHtml(clientCopy.milestones)}</h3>${history}</section><section class="company-detail-section" id="tool-company-selection"><p class="section-code">05 / SELECTION</p><h3>${escapeHtml(clientCopy.selection)}</h3><div class="company-detail-columns"><div><h4>${escapeHtml(clientCopy.investmentView)}</h4>${investment}</div><div><h4>${escapeHtml(clientCopy.verification)}</h4><p class="detail-muted">${escapeHtml(record.verificationFocus)}</p><ol class="selection-check-list">${(profile.questions || [record.verificationFocus]).map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ol></div></div>${renderSourceLinks(evidence?.sourceLinks)}</section>${renderCompanySectionRail()}`;
