import { getJeelingTaxonomy } from "../data/repository/jeeling-taxonomy";
import ToolAppLayout from "../layouts/ToolAppLayout.astro";

interface Props { locale?: Locale; }

const { locale = "zh" } = Astro.props;
const isZh = locale === "zh";

const { catalogTaxonomy, primaryCatalogs, productClasses, parameterSchemas } = getJeelingTaxonomy(locale);
