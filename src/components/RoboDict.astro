      }
      resultCount.textContent = String(found.length);
      resultUnit.textContent = role === "investment" ? clientCopy.companiesUnit : clientCopy.productsUnit;
      const baseResultMode = role === "investment" ? clientCopy.groupedByCompany : (scenarioIntent ? clientCopy.scenarioGrouped : clientCopy.groupedByProduct);
      const confirmedCount = found.filter((record) => record.constraintState === "confirmed").length;
      const possibleCount = found.filter((record) => record.constraintState === "indeterminate").length;
      resultModeLabel.textContent = role === "technical" && (confirmedCount || possibleCount)
        ? `${baseResultMode} · ${clientCopy.matchSummary.confirmed} ${confirmedCount} · ${clientCopy.matchSummary.possible} ${possibleCount}`
        : baseResultMode;
      resultHeading.textContent = role === "investment" ? clientCopy.companyCandidates : (scenarioIntent ? clientCopy.scenarioCandidates : clientCopy.productCandidates);
      if (!activeId) {
        resultCurrent.textContent = resultHeading.textContent;
        setResultRailOpen(true);
      }
      if (!found.length) { resultList.innerHTML = `<div class="no-results"><span>?</span><p>${escapeHtml(clientCopy.empty)}</p></div>`; showDetail(null); return; }
      const groupMap = role === "investment" ? clientCopy.countries : (scenarioIntent ? clientCopy.scenarioGroups : clientCopy.productClasses);
      const groupFor = (record) => role === "investment" ? record.investor.country : (scenarioIntent ? recommendationRoleFor(record) : record.catalogSubclass);
      const presentGroupIds = [...new Set(found.map((record) => groupFor(record)).filter(Boolean))];
      const groupOrder = [
        ...Object.keys(groupMap).filter((groupId) => presentGroupIds.includes(groupId)),
        ...presentGroupIds.filter((groupId) => !Object.prototype.hasOwnProperty.call(groupMap, groupId)),
      ];
      if (role === "technical") {
        const constraintRank = { confirmed: 0, "not-requested": 1, indeterminate: 2 };
        groupOrder.sort((left, right) => {
          const leftItems = found.filter((record) => groupFor(record) === left);
          const rightItems = found.filter((record) => groupFor(record) === right);
          const leftRank = Math.min(...leftItems.map((record) => constraintRank[record.constraintState]));
          const rightRank = Math.min(...rightItems.map((record) => constraintRank[record.constraintState]));
          const leftRelevance = Math.max(...leftItems.map((record) => record.relevance));
          const rightRelevance = Math.max(...rightItems.map((record) => record.relevance));
          return leftRank - rightRank || rightRelevance - leftRelevance;
        });
      }
      let resultIndex = 0;
      if (activeId) {
        const ordered = groupOrder.flatMap(groupId => found.filter(record => groupFor(record) === groupId));
        const activePosition = ordered.findIndex(record => record.id === activeId);
        if (activePosition >= resultLimit) resultLimit = Math.ceil((activePosition + 1) / 120) * 120;
      }
      resultList.innerHTML = groupOrder.map((groupId) => {
        const groupItems = found.filter((record) => groupFor(record) === groupId);
        if (!groupItems.length || resultIndex >= resultLimit) return "";
        const rows = groupItems.slice(0, resultLimit - resultIndex).map((record) => {
          resultIndex += 1;
          const title = role === "investment" ? record.company : record.product;
          const subtitle = role === "investment" ? `${countryName(record.investor.country)} · ${publicStageName(record.investor.publicStage)}` : record.company;
          const checked = selected.includes(record.id);
          const compareDisabled = role === "technical" && selected.length >= 5 && !checked;
          const matchLabel = record.constraintState === "confirmed" ? clientCopy.confirmedMatch : record.constraintState === "indeterminate" ? clientCopy.possibleMatch : "";
          const recordScope = `${scenarioIntent ? clientCopy.scenarioMatch : (isModelRecord(record) ? clientCopy.modelLevel : clientCopy.seriesLevel)} · ${clientCopy.coverage} ${coverageFor(record).known}/${coverageFor(record).total}`;
          const small = role === "investment" ? fundingScaleName(record.investor.fundingScale) : [matchLabel, recordScope].filter(Boolean).join(" · ");
          return `<article class="result-row ${role === "investment" ? "company-row" : ""} ${record.constraintState === "indeterminate" ? "parameter-indeterminate" : ""} ${record.id === activeId ? "active" : ""}"><button class="result-open" type="button" data-open="${escapeHtml(record.id)}"><span class="result-index">${String(resultIndex).padStart(2, "0")}</span><span class="result-copy"><small>${escapeHtml(small)}</small><strong>${escapeHtml(title)}</strong><span>${escapeHtml(subtitle)}</span></span><span class="result-chevron" aria-hidden="true">›</span></button>${role === "technical" ? `<button class="compare-toggle ${checked ? "selected" : ""}" type="button" data-compare="${escapeHtml(record.id)}" aria-pressed="${String(checked)}" title="${escapeHtml(clientCopy.compare)}" ${compareDisabled ? "disabled" : ""}><span>${checked ? "✓" : "+"}</span></button>` : ""}</article>`;
        }).join("");
        const groupLabel = groupMap[groupId] || (role === "investment" ? countryName(groupId) : groupItems[0]?.type) || groupId;
        return `<details class="result-group" open><summary><strong>${escapeHtml(groupLabel)}</strong><span>${groupItems.length}</span></summary>${rows}</details>`;
      }).join("");
      if (found.length > resultLimit) resultList.insertAdjacentHTML('beforeend', `<button type="button" class="catalog-more" data-results-more>${locale === 'zh' ? '显示更多结果' : 'More results'} (${resultLimit} / ${found.length})</button>`);
      if (!found.some((record) => record.id === activeId)) { activeId = ""; showDetail(null); }
    };
    const resetSelects = () => {
      [...investorSelects, ...technicalSelects].forEach((select) => { select.value = "all"; });
      selectedInterfaces.clear();
      interfaceFilter.open = false;
      syncPrimaryOptions();
      syncSubclassOptions();
    };
    const applyRoleControls = () => {
      roleButtons.forEach((button) => { const active = button.dataset.role === role; button.classList.toggle("active", active); button.setAttribute("aria-pressed", String(active)); });
      investmentFilters.hidden = role !== "investment";
      technicalFilters.hidden = role !== "technical";
      technicalCapabilities.hidden = role !== "technical";
      inputLabel.textContent = clientCopy.searchLabels[role];
      input.placeholder = clientCopy.placeholders[role];
    };
    const historyUrl = () => {
      const url = new URL(window.location.href);
      historyParameterNames.forEach((name) => url.searchParams.delete(name));
      if (role !== "investment") url.searchParams.set("mode", role);
      if (input.value.trim()) url.searchParams.set("q", input.value.trim());
      historySelects.forEach(({ name, select }) => {
        if (select.value !== "all") url.searchParams.set(name, select.value);
      });
      if (selectedInterfaces.size) url.searchParams.set("interfaces", [...selectedInterfaces].join("|"));
      if (activeId) url.searchParams.set("active", activeId);
      return `${url.pathname}${url.search}${url.hash}`;
    };
    const commitHistory = (mode = "replace") => {
      if (restoringHistory) return;
      window.history[mode === "push" ? "pushState" : "replaceState"]({ jeeling: true }, "", historyUrl());
    };
    const setSelectFromHistory = (select, value) => {
      if (!value) return;
      const option = [...select.options].find((item) => item.value === value && !item.disabled);
      if (option) select.value = value;
    };
    let activationRevision = 0;
    let historyRestoration = 0;
    const activateRecords = async (nextRole) => {
      const requestRevision = ++activationRevision;
      const loading = document.querySelector('#catalog-loading');
      const controls = document.querySelector('#finder-controls');
      controls.disabled = true;
      roleButtons.forEach(button => { button.disabled = true; });
      form.setAttribute('aria-busy', 'true');
      loading.hidden = false;
      loading.textContent = locale === 'zh' ? '正在加载产品索引…' : 'Loading product index…';
      try {
        if (nextRole === 'technical' && !productRecords) productRecords = (await loadPart('products')).records;
        if (requestRevision !== activationRevision) return false;
        records = nextRole === 'technical' ? productRecords : companyRecords;
        recordById = new Map(records.map(record => [record.id, record]));
        parameterAliases = nextRole === 'technical' ? (technicalParameterAliases ||= buildParameterAliases(records)) : buildParameterAliases([]);
        role = nextRole;
        loading.hidden = true;
        return true;
      } catch (error) {
        if (requestRevision !== activationRevision) return false;
        console.error('Jeeling product index failed', error);
        loading.textContent = locale === 'zh' ? '产品索引加载失败，请再次选择查询产品重试。' : 'Product index failed to load. Select Find products to retry.';
        return false;
      } finally {
        if (requestRevision === activationRevision) {
          controls.disabled = false;
          roleButtons.forEach(button => { button.disabled = false; });
          form.setAttribute('aria-busy', 'false');
        }
      }
    };
    const restoreHistory = async () => {
      const restoreRequest = ++historyRestoration;
      restoringHistory = true;
      const params = new URLSearchParams(window.location.search);
      input.value = params.get('q') || '';
      if (!await activateRecords(params.get('mode') === 'technical' ? 'technical' : 'investment')) {
        if (restoreRequest === historyRestoration) restoringHistory = false;
        return false;
      }
      activeId = "";
      selected = [];
      input.value = params.get("q") || "";
      resetSelects();
      applyRoleControls();

      setSelectFromHistory(countryFilter, params.get("country"));
      setSelectFromHistory(publicStageFilter, params.get("progress"));
      setSelectFromHistory(fundingStageFilter, params.get("funding"));
      setSelectFromHistory(fundingScaleFilter, params.get("scale"));

      setSelectFromHistory(catalogLevelFilter, params.get("level"));
      syncPrimaryOptions();
      setSelectFromHistory(primaryCategoryFilter, params.get("primary"));
      syncSubclassOptions();
      setSelectFromHistory(productClassFilter, params.get("class"));
      syncPrecisionFacets();
      syncDependentOptions();
      setSelectFromHistory(manufacturerFilter, params.get("maker"));
      historySelects.slice(8).forEach(({ name, select }) => setSelectFromHistory(select, params.get(name)));

      selectedInterfaces = new Set((params.get("interfaces") || "").split("|").filter(Boolean));
      syncDependentOptions();
      activeId = params.get("active") || "";
      renderCompareDock();
      renderResults();
      const activeRecord = activeId ? findRecord(activeId) : null;
      if (activeRecord) await showDetail(activeRecord);
      if (restoreRequest !== historyRestoration) return false;
      setResultRailOpen(!workspace.hidden);
      restoringHistory = false;
      return true;
    };
    const setRole = async (nextRole) => {
      historyRestoration++;
      restoringHistory = false;
      if (!await activateRecords(nextRole)) return;
      activeId = "";
      selected = [];
      input.value = "";
      resetSelects();
      syncPrecisionFacets();
      syncDependentOptions();
      applyRoleControls();
      renderCompareDock();
      renderResults();
      commitHistory("push");
    };

    resultRailToggle.addEventListener("click", () => {
      setResultRailOpen(true);
      resultRailCollapse.focus({ preventScroll: true });
    });
    resultRailCollapse.addEventListener("click", () => {
      setResultRailOpen(false);
      resultRailToggle.focus({ preventScroll: true });
    });
    resultPane.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      setResultRailOpen(false);
      resultRailToggle.focus({ preventScroll: true });
    });
    roleButtons.forEach((button) => button.addEventListener("click", () => setRole(button.dataset.role || "investment")));
    [...investorSelects, ...technicalSelects].forEach((select) => select.addEventListener("change", () => {
      activeId = "";
      if (select === catalogLevelFilter) syncPrimaryOptions();
      if (select === primaryCategoryFilter || select === catalogLevelFilter) syncSubclassOptions();
      if (select === primaryCategoryFilter || select === productClassFilter || select === catalogLevelFilter) syncPrecisionFacets();
      if (select === primaryCategoryFilter || select === productClassFilter || select === catalogLevelFilter) syncDependentOptions();
      renderResults();
      commitHistory();
    }));
    interfaceOptions.addEventListener("change", (event) => {
      const checkbox = event.target.closest('input[type="checkbox"]');
      if (!checkbox) return;
      if (checkbox.checked) selectedInterfaces.add(checkbox.value);
      else selectedInterfaces.delete(checkbox.value);
      interfaceCount.textContent = String(selectedInterfaces.size);
      activeId = "";
      renderResults();
      commitHistory();
    });
    form.addEventListener("submit", (event) => { event.preventDefault(); activeId = ""; renderResults(); commitHistory("push"); });
    input.addEventListener("input", () => { if (!input.value.trim()) { activeId = ""; renderResults(); commitHistory(); } });
    document.querySelector("#finder-reset").addEventListener("click", () => { input.value = ""; resetSelects(); syncPrecisionFacets(); syncDependentOptions(); activeId = ""; selected = []; renderCompareDock(); renderResults(); commitHistory("push"); input.focus(); });
    resultList.addEventListener("click", (event) => {
      if (event.target.closest('[data-results-more]')) { resultLimit += 120; renderResults(false); return; }
      const compareButton = event.target.closest("[data-compare]");
      if (compareButton) {
        const id = compareButton.dataset.compare;
        if (selected.includes(id)) selected = selected.filter((item) => item !== id);
        else if (selected.length < 5) selected = [...selected, id];
        renderCompareDock();
        renderResults(false);
        return;
      }
      const openButton = event.target.closest("[data-open]");
      if (!openButton) return;
      activeId = openButton.dataset.open;
      showDetail(findRecord(activeId));
      [...resultList.querySelectorAll(".result-row")].forEach((row) => row.classList.toggle("active", row.querySelector("[data-open]")?.dataset.open === activeId));
      setResultRailOpen(true);
      commitHistory("push");
      const workspaceTop = workspace.getBoundingClientRect().top + window.scrollY - 76;
      if (window.scrollY > workspaceTop + 24) window.scrollTo({ top: workspaceTop, behavior: "auto" });
    });
    detailPane.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest("[data-history-filter]");
      const history = button?.closest("[data-company-history]");
      if (!(button instanceof HTMLButtonElement) || !(history instanceof HTMLElement)) return;
      history.dataset.activeKind = button.dataset.historyFilter || "all";
      history.querySelectorAll("[data-history-filter]").forEach((item) => {
        item.setAttribute("aria-pressed", String(item === button));
      });
    });
    document.querySelector("#compare-clear").addEventListener("click", () => { selected = []; renderCompareDock(); renderResults(false); });
    compareOpen.addEventListener("click", () => {
      const chosen = selected.map(findRecord).filter(Boolean);
      document.querySelector("#comparison-grid").innerHTML = chosen.map((record) => `<article><p>${escapeHtml(categoryName(record.catalogPrimary))} · ${escapeHtml(productGroupName(record))}</p><h3>${escapeHtml(record.product)}</h3><strong>${escapeHtml(record.company)}</strong><dl><div><dt>${escapeHtml(clientCopy.technicalFilters.catalogLevel)}</dt><dd>${escapeHtml(isModelRecord(record) ? clientCopy.modelLevel : clientCopy.seriesLevel)}</dd></div><div><dt>${escapeHtml(clientCopy.type)}</dt><dd>${escapeHtml(record.type)}</dd></div><div><dt>${escapeHtml(clientCopy.openness)}</dt><dd>${escapeHtml(record.openness)}</dd></div><div><dt>${escapeHtml(clientCopy.integration)}</dt><dd>${escapeHtml(record.integration)}</dd></div><div><dt>${escapeHtml(clientCopy.verification)}</dt><dd>${escapeHtml(record.verificationFocus)}</dd></div></dl></article>`).join("");
      compareDialog.showModal();
    });
    document.querySelector("#compare-close").addEventListener("click", () => compareDialog.close());
    compareDialog.addEventListener("click", (event) => { if (event.target === compareDialog) compareDialog.close(); });
    window.addEventListener("popstate", restoreHistory);
    const restored = await restoreHistory();
    if (restored) commitHistory();
    document.querySelector("#finder-controls").disabled = false;
    roleButtons.forEach(button => { button.disabled = false; });
    form.setAttribute("aria-busy", "false");
    document.querySelector("#catalog-loading").hidden = restored;
    })().catch((error) => {
      console.error("Jeeling catalog initialization failed", error);
      document.querySelector("#catalog-loading").textContent = locale === "zh" ? "资料库加载失败，请刷新重试。" : "Catalog loading failed. Refresh to retry.";
      alert(locale === "zh" ? "资料库加载失败，请刷新页面或使用更新版本的浏览器。" : "The catalog could not load. Refresh the page or use an up-to-date browser.");
    });
  }
</script>

<style is:global>
  .robodict { --soft-panel: color-mix(in srgb, var(--teal) 7%, var(--surface)); --directory-width: clamp(260px, 17vw, 300px); --workspace-gap: 20px; width: min(1800px, calc(100% - 48px)); margin-inline: auto; padding: 24px 0 84px; transition: width 150ms ease, margin-left 150ms ease; }
