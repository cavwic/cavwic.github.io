  .interface-filter summary span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .interface-filter summary strong { min-width: 22px; margin-left: auto; color: var(--teal); font-family: var(--mono); font-size: 12px; text-align: center; }
  .interface-filter[open] summary { border-color: var(--teal); }
  .interface-options { position: absolute; z-index: 8; top: calc(100% + 4px); left: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; width: min(420px, calc(100vw - 52px)); max-height: 220px; padding: 8px; overflow-y: auto; border: 1px solid var(--line); border-radius: 3px; background: var(--surface); box-shadow: 0 14px 30px rgb(0 0 0 / 16%); }
  .interface-options label { display: flex; gap: 7px; align-items: center; min-height: 38px; padding: 5px 8px; color: var(--ink); border: 1px solid transparent; border-radius: 2px; font-size: 13px; cursor: pointer; }
  .interface-options label:hover { border-color: var(--teal); background: color-mix(in srgb, var(--teal) 7%, transparent); }
  .interface-options input { width: 15px; height: 15px; accent-color: var(--teal); }
  .interface-options p { grid-column: 1 / -1; margin: 0; padding: 8px; color: var(--ink-soft); font-size: 13px; }
  .interface-filter.empty summary strong { color: var(--ink-soft); }
  .parameter-schema { min-height: 46px; padding: 8px 12px; border-left: 2px solid var(--teal); background: color-mix(in srgb, var(--teal) 5%, transparent); }
  .parameter-schema > span { display: block; margin-bottom: 6px; color: var(--ink-soft); font-family: var(--mono); font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .parameter-schema > div { display: flex; gap: 5px; flex-wrap: wrap; }
  .parameter-schema > div span { padding: 4px 7px; color: var(--ink); border: 1px solid var(--line); border-radius: 2px; background: var(--surface); font-size: 12px; line-height: 1.3; }
