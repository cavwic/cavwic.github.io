  .query-input:focus-within { border-color: var(--teal); box-shadow: 0 0 0 2px color-mix(in srgb, var(--teal) 16%, transparent); }
  .query-input input { width: 100%; min-width: 0; height: 46px; padding: 0; color: var(--ink); border: 0; outline: 0; background: transparent; font: inherit; font-size: 16px; }
  .search-button, .reset-button, .compare-dock button { display: inline-flex; gap: 7px; align-items: center; justify-content: center; min-height: 46px; padding: 0 16px; color: var(--on-signal); border: 1px solid var(--signal); border-radius: 3px; background: var(--signal); font: inherit; font-size: 14px; font-weight: 700; cursor: pointer; }
  .reset-button { width: 46px; padding: 0; color: var(--ink); border-color: var(--line); background: transparent; }
