const alternatePath = isZh ? "/en/tools/product-finder-demo" : "/tools/product-finder-demo";
---

<ToolAppLayout title={`${copy.title} | CAVWIC`} description={copy.description} locale={locale} alternatePath={alternatePath}>
  <div class="robodict">
    <header class="dict-head">
      <div>
        <p class="dict-kicker">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p>{copy.intro} <span id="finder-catalog-count">{copy.catalog}</span></p>
      </div>
      <nav class="role-switch" aria-label={isZh ? "查询模式" : "Query mode"}>
        {copy.roles.map((role, index) => (
          <button type="button" class:list={[index === 0 && "active"]} data-role={role.id} aria-pressed={index === 0 ? "true" : "false"} disabled>
            {role.id === "investment" ? <BriefcaseBusiness size={19} aria-hidden="true" /> : <Wrench size={19} aria-hidden="true" />}
            <span><strong>{role.label}</strong><small>{role.detail}</small></span>
          </button>
        ))}
      </nav>
    </header>

    <section class="query-panel">
      <p id="catalog-loading" role="status">{isZh ? "正在加载资料库…" : "Loading catalog…"}</p>
      <form id="finder-form" aria-busy="true">
        <fieldset id="finder-controls" disabled>
        <label class="sr-only" id="finder-label" for="finder-input">{copy.searchLabels.investment}</label>
        <div class="query-row">
          <div class="query-input"><Search size={21} aria-hidden="true" /><input id="finder-input" type="search" autocomplete="off" placeholder={copy.placeholders.investment} /></div>
          <button class="search-button" type="submit"><Search size={18} aria-hidden="true" /> {copy.search}</button>
          <button class="reset-button" id="finder-reset" type="button" aria-label={copy.reset} title={copy.reset}><RotateCcw size={19} aria-hidden="true" /></button>
        </div>

        <div class="filter-row investment-filters" id="investment-filters">
          <select id="country-filter" aria-label={copy.investorFilters.country}><option value="all">{copy.investorFilters.country}</option>{Object.entries(copy.countries).map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <select id="public-stage-filter" aria-label={copy.investorFilters.publicStage}><option value="all">{copy.investorFilters.publicStage}</option>{Object.entries(copy.publicStages).map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <select id="funding-stage-filter" aria-label={copy.investorFilters.fundingStage}><option value="all">{copy.investorFilters.fundingStage}</option>{Object.entries(copy.fundingStages).map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <select id="funding-scale-filter" aria-label={copy.investorFilters.fundingScale}><option value="all">{copy.investorFilters.fundingScale}</option>{Object.entries(copy.fundingScales).map(([value, label]) => <option value={value}>{label}</option>)}</select>
        </div>

        <div class="filter-row technical-filters" id="technical-filters" hidden>
          <select id="primary-category-filter" aria-label={copy.technicalFilters.primary}><option value="all">{copy.technicalFilters.primary}</option>{Object.entries(copy.primaryCatalogs).map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <select id="product-class-filter" aria-label={copy.technicalFilters.productClass} disabled><option value="all">{copy.technicalFilters.productClass}</option></select>
          <select id="manufacturer-filter" aria-label={copy.technicalFilters.manufacturer}><option value="all">{copy.technicalFilters.manufacturer}</option></select>
          <select id="catalog-level-filter" aria-label={copy.technicalFilters.catalogLevel}><option value="all">{copy.technicalFilters.catalogLevel}</option>{Object.entries(copy.catalogLevels).map(([value, label]) => <option value={value}>{label}</option>)}</select>
        </div>

        <div class="technical-capabilities" id="technical-capabilities" hidden>
          <details class="interface-filter" id="interface-filter">
            <summary><span>{copy.technicalFilters.interface}</span><strong id="interface-count">0</strong></summary>
            <div class="interface-options" id="interface-options"></div>
          </details>
          <div class="parameter-schema" id="parameter-schema" hidden>
            <span>{copy.technicalFilters.parameterFields}</span>
            <div id="parameter-schema-items"></div>
          </div>
        </div>

        <div class="filter-row precision-facets" data-precision-facets="motor-servo" hidden>
          <select id="motor-voltage-filter" aria-label={copy.facetFilters.voltage}><option value="all">{copy.facetFilters.voltage}</option><option value="lte:12">{copy.facetOptions.upTo12V}</option><option value="eq:24">{copy.facetOptions.v24}</option><option value="eq:48">{copy.facetOptions.v48}</option></select>
          <select id="motor-torque-filter" aria-label={copy.facetFilters.torque}><option value="all">{copy.facetFilters.torque}</option><option value="lte:2">{copy.facetOptions.torqueUpTo2}</option><option value="range:2:5">{copy.facetOptions.torque2To5}</option><option value="gt:5">{copy.facetOptions.torqueOver5}</option></select>
          <select id="motor-speed-filter" aria-label={copy.facetFilters.speed}><option value="all">{copy.facetFilters.speed}</option><option value="lte:60">{copy.facetOptions.speedUpTo60}</option><option value="range:61:200">{copy.facetOptions.speed61To200}</option><option value="gt:200">{copy.facetOptions.speedOver200}</option></select>
          <select id="motor-mass-filter" aria-label={copy.facetFilters.mass}><option value="all">{copy.facetFilters.mass}</option><option value="lte:100">{copy.facetOptions.massUpTo100}</option><option value="range:101:300">{copy.facetOptions.mass101To300}</option><option value="gt:300">{copy.facetOptions.massOver300}</option></select>
        </div>

        <div class="filter-row precision-facets" data-precision-facets="integrated-joint" hidden>
          <select id="joint-voltage-filter" aria-label={copy.facetFilters.voltage}><option value="all">{copy.facetFilters.voltage}</option><option value="eq:24">{copy.facetOptions.v24}</option><option value="eq:48">{copy.facetOptions.v48}</option></select>
          <select id="joint-rated-torque-filter" aria-label={copy.facetFilters.ratedTorque}><option value="all">{copy.facetFilters.ratedTorque}</option><option value="lte:2">{copy.facetOptions.torqueUpTo2}</option><option value="range:2:5">{copy.facetOptions.torque2To5}</option><option value="gt:5">{copy.facetOptions.torqueOver5}</option></select>
          <select id="joint-peak-torque-filter" aria-label={copy.facetFilters.peakTorque}><option value="all">{copy.facetFilters.peakTorque}</option><option value="lte:5">{copy.facetOptions.torqueUpTo5}</option><option value="range:5:15">{copy.facetOptions.torque5To15}</option><option value="gt:15">{copy.facetOptions.torqueOver15}</option></select>
          <select id="joint-ratio-filter" aria-label={copy.facetFilters.reductionRatio}><option value="all">{copy.facetFilters.reductionRatio}</option><option value="lte:6">{copy.facetOptions.ratioUpTo6}</option><option value="range:6:10">{copy.facetOptions.ratio6To10}</option><option value="gt:10">{copy.facetOptions.ratioOver10}</option></select>
