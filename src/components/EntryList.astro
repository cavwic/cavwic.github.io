---
import { ArrowUpRight } from "@lucide/astro";
import { statusLabels, type Entry, type Locale } from "../data/site";

interface Props {
  entries: Entry[];
  locale?: Locale;
}

const { entries, locale = "zh" } = Astro.props;
---

<div class="entry-list">
  {entries.map((entry) => (
    <article class="entry-row">
      <div class="entry-meta">
        <span class:list={["status", `status-${entry.status}`]}>{statusLabels[locale][entry.status]}</span>
        {entry.date && <time>{entry.date}</time>}
      </div>
      <div class="entry-copy">
        <h2>
          {entry.href ? (
            <a
              class="entry-title-link"
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noreferrer" : undefined}
            >
              {entry.title}
              <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
            </a>
          ) : entry.title}
        </h2>
        <p>{entry.description}</p>
      </div>
    </article>
  ))}
</div>
