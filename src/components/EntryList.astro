---
import { ArrowUpRight } from "@lucide/astro";
import { statusLabels, type Entry, type Locale } from "../data/site";
import ToolVersionDialog from "./ToolVersionDialog.astro";

interface Props {
  entries: Entry[];
  locale?: Locale;
  showMeta?: boolean;
}

const { entries, locale = "zh", showMeta = true } = Astro.props;
---

<div class="entry-list">
  {entries.map((entry, index) => (
    <article class:list={["entry-row", !showMeta && "entry-row-plain"]}>
      {showMeta && (
        <div class="entry-meta">
          <span class:list={["status", `status-${entry.status}`]}>{statusLabels[locale][entry.status]}</span>
          {entry.date && <time>{entry.date}</time>}
        </div>
      )}
      <div class="entry-copy">
        <h2>
          {entry.href ? (
            <a
              class="entry-title-link"
              href={entry.href}
              target={entry.external ? "_blank" : undefined}
              rel={entry.external ? "noreferrer" : undefined}
              data-tool-version-open={entry.versionPicker ? `tool-version-${locale}-${index}` : undefined}
              aria-haspopup={entry.versionPicker ? "dialog" : undefined}
              aria-controls={entry.versionPicker ? `tool-version-${locale}-${index}` : undefined}
            >
              {entry.title}
              <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
            </a>
          ) : entry.title}
        </h2>
        <p>{entry.description}</p>
      </div>
      {entry.href && entry.versionPicker && (
        <ToolVersionDialog
          id={`tool-version-${locale}-${index}`}
          title={entry.title}
          webHref={entry.href}
          webExternal={entry.external}
          downloadHref={entry.versionPicker.downloadHref}
          locale={locale}
        />
      )}
    </article>
  ))}
</div>
