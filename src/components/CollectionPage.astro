---
import BaseLayout from "../layouts/BaseLayout.astro";
import EntryList from "./EntryList.astro";
import type { Entry, Locale } from "../data/site";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  entries: Entry[];
  locale?: Locale;
}

const { eyebrow, title, intro, entries, locale = "zh" } = Astro.props;
---

<BaseLayout title={`${title} | CAVWIC`} description={intro} locale={locale}>
  <header class="page-head">
    <div class="page-head-inner">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p>{intro}</p>
    </div>
  </header>
  <section class="collection" aria-label={locale === "zh" ? `${title}列表` : `${title} list`}>
    <EntryList entries={entries} locale={locale} />
  </section>
</BaseLayout>
