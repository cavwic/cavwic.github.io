---
import { ArrowLeft, Languages, Moon, Sun, RotateCcw, Download, Play, Camera } from '@lucide/astro';
import { labCopy } from '../features/hand-retargeting/copy';
import RoboticsLabNav from './RoboticsLabNav.astro';
import ExperimentActions from './ExperimentActions.astro';
const { locale = 'zh', inWorkbench = false } = Astro.props as { locale?: 'zh' | 'en'; inWorkbench?: boolean };
const c = labCopy[locale];
const prefix = locale === 'zh' ? '' : '/en';
const alternate = `${locale === 'zh' ? '/en' : ''}/tools/${inWorkbench ? 'robotics-lab/' : ''}hand-retargeting`;
const overview = `${prefix}/tools/robotics-lab`;
const gestures = ['open','fist','pinch','point','spread','wave','unreachable'] as const;
const fingers = ['thumb','index','middle','ring','little'] as const;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-locale={locale} data-theme="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.name} · Cavwic</title><meta name="description" content={c.intro} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={locale === 'zh' ? 'en' : 'zh-CN'} href={new URL(alternate, Astro.site)} />
    <script is:inline>
      try { const pref = localStorage.getItem('cavwic-theme'); document.documentElement.dataset.theme = pref === 'light' || pref === 'dark' ? pref : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; document.documentElement.dataset.themePreference = pref || 'system'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{locale === 'zh' ? '跳到实验' : 'Skip to experiment'}</a>
    <header class="lab-bar">
      <a class="identity" href={inWorkbench ? overview : `${prefix}/tools`}><span>{inWorkbench ? locale === 'zh' ? '灵巧操作实验台' : 'Manipulation labs' : c.name}<small>{inWorkbench ? 'CAVWIC · ROBOTICS WORKBENCH' : 'CAVWIC / KINEMATICS LAB'}</small></span></a>
      <nav aria-label={locale === 'zh' ? '页面控制' : 'Page controls'}>
        <a class="back" href={inWorkbench ? overview : `${prefix}/tools`}><ArrowLeft size={18}/><span>{inWorkbench ? locale === 'zh' ? '实验总览' : 'All experiments' : c.back}</span></a>
        <a class="icon-button" href={alternate} title={c.language} aria-label={c.language}><Languages size={20}/><span>{locale === 'zh' ? 'EN' : '中'}</span></a>
        <button id="theme-toggle" class="icon-button" title={c.theme} aria-label={c.theme}><Moon class="moon" size={20}/><Sun class="sun" size={20}/></button>
      </nav>
    </header>
    <main id="main" class:list={{'robotics-main':inWorkbench}}>
      {inWorkbench && <div class="workbench-breadcrumb"><a href={overview}>{locale === 'zh' ? '实验总览' : 'All experiments'}</a><span>/</span><span>02 · {locale === 'zh' ? '人手动作重定向' : 'Hand motion retargeting'}</span></div>}
      <section class="intro"><div><p class="eyebrow">{inWorkbench ? 'EXPERIMENT 02 / RETARGETING' : c.eyebrow}</p><h1>{inWorkbench ? locale === 'zh' ? '人手动作重定向' : 'Hand motion retargeting' : c.title}</h1><p>{c.intro}</p></div><div class="scope"><span class="live-dot"></span>{c.badge}<small>{c.model}</small></div></section>
      <ExperimentActions locale={locale} />
      {inWorkbench && <RoboticsLabNav locale={locale} activeSlug="hand-retargeting" />}
      <section class="workspace" id="workspace" data-source="synthetic" aria-label={c.name}>
        <aside class="controls">
          <div class="control-section input-source-section"><div class="section-heading"><h2>{c.inputSource}</h2><span class="unit">21 XYZ</span></div>
            <div class="source-tabs"><button data-source="synthetic" class="active">{c.synthetic}</button><button data-source="camera">{c.camera}</button></div>
            <div class="transport sequence-transport"><button id="play"><Play size={17}/><span>{c.play}</span></button><input id="time" type="range" min="0" max="6" step="0.02" value="1.2" aria-label={c.time}/><output id="time-value">1.20 s</output></div>
            <div id="camera-controls" hidden>
              <label class="field-label" for="camera-hand">{c.cameraHand}<select id="camera-hand" aria-describedby="camera-hand-hint"><option value="Right" selected>{c.cameraHandRight}</option><option value="Left">{c.cameraHandLeft}</option></select></label><p id="camera-hand-hint" class="hint">{c.cameraHandHint}</p>
              <button id="vision-check" class="text-button">{c.visionCheck}</button><p id="vision-check-status" class="hint" role="status"></p><p class="hint">{c.cameraHint}</p>
            </div>
            <p id="input-status" role="status" class="input-status">{c.statusSynthetic}</p>
          </div>
          <fieldset id="synthetic-controls" class="control-section synthetic-section" aria-labelledby="synthetic-heading">
            <h2 id="synthetic-heading">{c.syntheticControls}</h2><p class="hint">{c.syntheticHint}</p>
            <div class="gesture-grid">{gestures.map(g => <button data-gesture={g} class={g==='pinch'?'active':''}>{c[g]}</button>)}</div>
            <details class="parameter-details"><summary>{c.syntheticAdvanced}</summary>
              <label class="slider-row" for="noise"><span>{c.noise}</span><output id="noise-value">0.0 mm</output><input id="noise" type="range" min="0" max="5" step="0.25" value="0"/></label>
              <div class="target-controls"><h3>{c.target}</h3><label class="select-row" for="finger">{c.finger}<select id="finger">{fingers.map((f,i)=><option value={i} selected={i===1}>{c[f]}</option>)}</select></label>
                {['x','y','z'].map(axis=><label class="slider-row" for={`offset-${axis}`}><span>{axis.toUpperCase()}</span><output id={`offset-${axis}-value`}>0 mm</output><input id={`offset-${axis}`} type="range" min="-80" max="80" step="1" value="0"/></label>)}
                <p class="hint">{c.offset}</p>
              </div>
            </details>
          </fieldset>
          <div class="control-section output-section"><h2>{c.algorithm}</h2><div class="segmented"><button data-algorithm="ik" class="active">{c.ik}</button><button data-algorithm="baseline">{c.baseline}</button></div>
            <label class="slider-row" for="smoothing"><span>{c.smoothing}</span><output id="smoothing-value">{c.smoothingOff}</output><input id="smoothing" type="range" min="0" max="0.3" step="0.01" value="0"/></label>
            <details class="parameter-details output-advanced"><summary>{c.advancedSettings}</summary>
              <label class="slider-row" for="input-filter"><span>{c.inputFilter}</span><output id="input-filter-value">30 ms</output><input id="input-filter" type="range" min="0" max="0.15" step="0.01" value="0.03" aria-describedby="input-filter-hint"/></label><p id="input-filter-hint" class="hint">{c.inputFilterHint}</p>
              <label class="slider-row" for="pinch-weight"><span>{c.pinchWeight}</span><output id="pinch-weight-value">3.00</output><input id="pinch-weight" type="range" min="0" max="8" step="0.25" value="3" aria-describedby="pinch-weight-hint"/></label><p id="pinch-weight-hint" class="hint">{c.pinchWeightHint}</p>
              <label class="check-row"><input id="limits" type="checkbox" checked/><span>{c.limits}</span></label>
              <label class="check-row"><input id="compare" type="checkbox" checked/><span>{c.compare}</span></label>
            </details>
            <p class="hint thumb-boundary">{c.thumbBoundary}</p>
          </div>
          <button id="reset" class="button full"><RotateCcw size={17}/>{c.reset}</button>
        </aside>
        <div class="experiment">
          <div class="stage-toolbar"><span>{c.stageTitle}</span><div><label class="check-row"><input id="skeleton" type="checkbox"/><span>{c.skeleton}</span></label><button id="front-view" class="text-button">{c.frontView}</button><button id="back-view" class="text-button">{c.backView}</button><button id="side-view" class="text-button">{c.sideView}</button><button id="camera-expand" class="text-button" aria-pressed="false" hidden>{c.cameraExpand}</button></div></div>
          <div class="stage-grid">
          <div id="camera-panel" class="camera-panel" hidden><div class="camera-heading"><div><strong>{c.cameraInput}</strong><span id="camera-resolution">{c.cameraLocal}</span></div><button id="camera-start" class="button primary"><Camera size={18}/><span>{c.cameraStart}</span></button></div><div class="camera-screen"><video id="camera-preview" muted playsinline aria-label={c.cameraInput}></video><canvas id="camera-overlay" aria-label={c.cameraOverlay}></canvas><div id="camera-placeholder"><Camera size={42}/><strong>{c.cameraWaiting}</strong><span>{c.cameraPrompt}</span></div></div><div class="camera-caption"><span id="camera-stage-status" role="status">{c.cameraWaiting}</span><span>{c.mirrored}</span></div></div>
          <div class="viewport-wrap"><div class="view-labels"><span>{c.human}<small id="source-label">{c.synthetic}</small></span><span>{c.robot}<small id="solver-status">{c.statusEffort}</small></span></div><div id="viewport" role="img" aria-label={locale==='zh'?'可交互三维人手关键点与机器人手对照':'Interactive 3D hand landmarks and robot comparison'}></div>
            <div class="view-footer"><div class="legend"><span><i class="target-dot"></i>{c.legendTarget}</span><span><i class="ik-dot"></i>{c.legendIK}</span><span><i class="baseline-dot"></i>{c.legendBaseline}</span></div><button id="view-reset" class="text-button">{c.viewReset}</button></div>
            <p class="viewport-hint">{c.drag}</p><p id="webgl-error" class="error" hidden>{c.noWebGL}</p>
          </div>
          </div>
          <div class="finger-key">{fingers.map((f,i)=><span><i style={`--finger-color:${['#e49b47','#e27661','#59ad9a','#648fd1','#9a7cc4'][i]}`}></i>{c[f]}</span>)}<small>{c.visualBoundary}</small></div>
          <div class="metrics"><div><span>{c.residual}</span><strong id="tip-error">—</strong><small>mm</small></div><div><span>{c.baselineResidual}</span><strong id="baseline-error">—</strong><small>mm</small></div><div><span>{c.solveTime}</span><strong id="solve-time">—</strong><small>ms</small></div><div><span>{c.violations}</span><strong id="violations">—</strong><small>/ 20</small></div></div>
          <p class="residual-note">{c.residualBoundary}</p>
          <section id="task-metrics" class="task-metrics" aria-labelledby="task-metrics-heading">
            <div class="section-heading"><h2 id="task-metrics-heading">{c.taskMetrics}</h2></div>
            <p class="hint task-metric-hint">{c.taskMetricHint}</p>
            <div class="pinch-metric-grid">
              <div><span>{c.inputPinch}</span><strong id="input-pinch">—</strong><small>mm</small></div>
              <div><span>{c.robotPinch}</span><strong id="robot-pinch">—</strong><small>mm</small></div>
              <div><span>{c.pinchError}</span><strong id="pinch-error">—</strong><small>mm</small></div>
              <div><span>{c.pinchVectorError}</span><strong id="pinch-vector-error">—</strong><small>mm</small></div>
            </div>
            <p class="pad-facing-check"><span>{c.padFacing}</span> <strong id="pad-facing">—</strong><small>{c.padFacingHint}</small></p>
            <div class="tracking-metric-grid">
              <div><span>{c.jitter}</span><p><strong id="jitter-value">—</strong><small>mm</small></p><small class="metric-explanation">{c.jitterHint}</small></div>
              <div><span>{c.pipelineTime}</span><p><strong id="pipeline-time">—</strong><small>ms</small></p><small class="metric-explanation">{c.pipelineTimeHint}</small></div>
              <div><span>{c.trackingLoss}</span><p><strong id="tracking-loss">—</strong><small>%</small></p><small class="metric-explanation">{c.trackingLossHint}</small></div>
            </div>
          </section>
          <div class="chart-block"><div class="section-heading"><h2>{c.history}</h2><span class="hint">{c.chartHint}</span></div><canvas id="history-chart" aria-label={c.history}></canvas></div>
        </div>
        <aside class="readout"><div class="section-heading"><h2>{c.joints}</h2><span class="unit">DEG</span></div><div id="joint-readout"></div>
          <div class="evaluation"><h2>{c.experiment}</h2><p class="hint">{c.reportNote}</p><button id="benchmark" class="button full primary">{c.run}</button><div id="benchmark-result" aria-live="polite"><p>{c.ready}</p></div><button id="report-download" class="button full" hidden><Download size={17}/>{c.reportDownload}</button></div>
        </aside>
        <details id="calibration-controls" class="calibration-controls calibration-workspace" open>
          <summary>{c.calibrationTitle}</summary>
          <div class="calibration-layout">
            <section class="calibration-guide" aria-label={c.calibrationSteps}>
              <h3>{c.calibrationSteps}</h3><p class="hint">{c.calibrationHint}</p><p class="calibration-source-note">{c.calibrationSourceHint}</p>
              <ol class="calibration-steps" aria-label={c.calibrationSteps}>
                <li data-calibration-phase="open"><span aria-hidden="true">1</span>{c.open}</li>
                <li data-calibration-phase="fist"><span aria-hidden="true">2</span>{c.fist}</li>
                <li data-calibration-phase="pinch"><span aria-hidden="true">3</span>{c.calibrationPinchStage}</li>
              </ol>
              <div class="synthetic-calibration-check"><button id="calibration-synthetic" class="text-button">{c.calibrationSynthetic}</button><p class="hint">{c.calibrationSyntheticHint}</p></div>
            </section>
            <section class="calibration-capture-column" aria-label={c.calibrationStep}>
              <h3>{c.calibrationStep}</h3>
              <label class="field-label" for="calibration-step">{c.calibrationStep}<select id="calibration-step"><option value="open">{c.calibrationOpen}</option><option value="fist">{c.calibrationFist}</option><option value="pinch">{c.calibrationPinch}</option></select></label>
              <button id="calibration-capture" class="button full" disabled>{c.calibrationCapture}</button>
              <p id="calibration-progress" class="calibration-progress" role="status">{c.calibrationIdle}</p>
              <button id="calibration-save" class="button full primary" disabled>{c.calibrationSave}</button>
            </section>
            <section class="calibration-profile-column" aria-label={c.calibrationQuality}>
              <h3>{c.calibrationQuality}</h3>
              <label class="field-label" for="calibration-name">{c.calibrationName}<input id="calibration-name" type="text" value={c.calibrationNameDefault} maxlength="60" autocomplete="off"/></label>
              <label class="check-row"><input id="calibration-enabled" type="checkbox" disabled/><span>{c.calibrationEnabled}</span></label>
              <p id="calibration-status" class="calibration-status" role="status">{c.calibrationStatusEmpty}</p>
              <p id="calibration-summary" class="hint calibration-summary">{c.calibrationSummaryEmpty}</p>
              <div class="calibration-file-actions"><label class="button profile-file-label">{c.calibrationImport}<input id="calibration-import" type="file" accept="application/json,.json" aria-label={c.calibrationImport}/></label><button id="calibration-export" class="button" disabled>{c.calibrationExport}</button></div>
              <button id="calibration-legacy-export" class="text-button" hidden>{c.calibrationLegacyExport}</button><button id="calibration-reset" class="text-button calibration-reset">{c.calibrationReset}</button>
            </section>
          </div>
        </details>
      </section>
      <div class="record-bar"><span class="hint" id="record-status">0 {c.frames}</span><div><label class="button file-label"><input id="import-file" type="file" accept="application/json,.json" hidden/>{c.import}</label><button id="export" class="button"><Download size={17}/>{c.download}</button></div></div>
      <section class="methods"><div><p class="eyebrow">{c.dataset}</p><h2>{c.boundary}</h2><ul><li>{c.evidence1}</li><li>{c.evidence2}</li><li>{c.evidence3}</li></ul></div><div><p class="eyebrow">FK → TARGET → IK → FK</p><h2>{c.method}</h2><p>{c.methodText}</p><details><summary>{locale==='zh'?'模型、指标与局限':'Model, metrics and limitations'}</summary><p>{c.modelText}</p><p>{c.metricText}</p></details><div class="method-links"><a href="/hand-retargeting/METHODS.md" download>{c.docs} ↗</a><button id="model-download" class="text-button">{c.modelDownload} ↗</button><a href="https://developers.google.com/edge/mediapipe/solutions/vision/hand_landmarker/web_js" target="_blank" rel="noreferrer">MediaPipe ↗</a><a href="https://www.cs.cmu.edu/~15464-s13/lectures/lecture6/iksurvey.pdf" target="_blank" rel="noreferrer">IK / DLS ↗</a></div></div></section>
      <p class="source-links"><a href="/hand-retargeting/source/engine.ts" download>{locale==='zh'?'算法源码':'Algorithm source'} ↗</a><a href="/hand-retargeting/source/test-hand-retargeting.mjs" download>{locale==='zh'?'数值测试':'Numerical tests'} ↗</a><a href="/hand-retargeting/sample-sequence.json" download>{locale==='zh'?'合成序列示例':'Synthetic sequence sample'} ↗</a><a href="/hand-retargeting/THIRD_PARTY.md" download>{locale==='zh'?'第三方模型与许可':'Third-party assets and licenses'} ↗</a></p>
      <section class="public-references"><div><p class="eyebrow">PUBLIC REFERENCES</p><h2>{c.referenceTitle}</h2><p class="hint">{c.referenceBoundary}</p></div><a href="https://thejerrycheng.github.io/geodex.html#playground" target="_blank" rel="noreferrer"><strong>GeoDEX ↗</strong><span>{c.referenceGeo}</span></a><a href="https://jc-bao.github.io/spider-project/" target="_blank" rel="noreferrer"><strong>SPIDER ↗</strong><span>{c.referenceSpider}</span></a><a href="https://yzqin.github.io/anyteleop/" target="_blank" rel="noreferrer"><strong>AnyTeleop ↗</strong><span>{c.referenceAny}</span></a></section>
    </main>
    <footer>CAVWIC · {locale==='zh'?'个人实践 / 运动学，不是接触物理仿真':'Personal practice / Kinematics, not contact physics'} <span>2026.10</span></footer>
    <script>import '../features/hand-retargeting/app';</script>
  </body>
</html>
<style is:global>
  .workbench-breadcrumb { display:flex;flex-wrap:wrap;gap:10px;font-size:13px;color:var(--rt-muted);margin-bottom:30px; }
  .workbench-breadcrumb a { text-decoration:underline;text-underline-offset:4px; }
  :root { --rt-paper:#edf2f7; --rt-surface:#fff; --rt-ink:#152b3c; --rt-muted:#586b7d; --rt-line:#cfd9e3; --rt-control-line:#74899e; --rt-blue:#2459ad; --rt-orange:#bf573c; --rt-orange-text:#b04d32; --rt-ghost:#aa862d; --rt-font:'Microsoft YaHei UI','Microsoft YaHei','Noto Sans SC',sans-serif; --rt-display:Bahnschrift,'DIN Alternate','Microsoft YaHei',sans-serif; --rt-mono:'Cascadia Code',Consolas,monospace; color-scheme:light; }
  html[data-theme=dark] { --rt-paper:#102031; --rt-surface:#172c40; --rt-ink:#e7edf5; --rt-muted:#a8bacc; --rt-line:#314b63; --rt-control-line:#738ba1; --rt-blue:#83b4ff; --rt-orange:#f59979; --rt-orange-text:#f59979; --rt-ghost:#ddbd65; color-scheme:dark; }
  * { box-sizing:border-box; } body { margin:0; background:var(--rt-paper); color:var(--rt-ink); font-family:var(--rt-font); font-size:16px; line-height:1.6; } button,input,select { font:inherit; } button,a,input,select { -webkit-tap-highlight-color:transparent; } button { cursor:pointer; } button:disabled { cursor:wait; opacity:.6; } a { color:inherit; text-decoration:none; } button { color:inherit; } [hidden] { display:none!important; } :focus-visible { outline:3px solid var(--rt-blue); outline-offset:3px; } .skip { position:fixed; top:8px; left:8px; transform:translateY(-180%); z-index:100; background:var(--rt-surface); padding:10px; } .skip:focus { transform:none; }
  .lab-bar { min-height:76px; display:flex; justify-content:space-between; align-items:center; padding:12px 3vw; gap:16px; border-bottom:1px solid var(--rt-line); background:var(--rt-surface); } .identity { display:flex; align-items:center; gap:14px; font-weight:700; font-size:18px; } .mark { font-family:var(--rt-display); font-weight:600; font-size:24px; color:var(--rt-blue); padding-right:14px; border-right:1px solid var(--rt-line); } .identity small { display:block; font:10px var(--rt-mono); letter-spacing:.14em; color:var(--rt-muted); margin-top:3px; } .lab-bar nav { display:flex; gap:10px; align-items:center; } .back,.icon-button { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:8px 12px; min-height:40px; border:1px solid var(--rt-line); background:transparent; border-radius:6px; font-size:14px; } .icon-button:hover,.back:hover { background:var(--rt-paper); } .sun { display:none; } [data-theme=dark] .sun { display:block; } [data-theme=dark] .moon { display:none; }
  main { max-width:1900px; margin:auto; padding:30px 3vw 0; } .intro { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:28px; } .eyebrow { font:11px var(--rt-mono); letter-spacing:.12em; color:var(--rt-blue); margin:0 0 10px; } h1 { margin:0 0 10px; font-family:var(--rt-display); font-size:clamp(27px,2.5vw,42px); letter-spacing:-.025em; line-height:1.25; font-weight:600; } .intro p:last-child { color:var(--rt-muted); margin:0; max-width:740px; } .scope { font-size:13px; white-space:nowrap; padding-bottom:4px; } .scope small { display:block; color:var(--rt-muted); padding-left:16px; } .live-dot { display:inline-block; width:6px; height:6px; border-radius:50%; background:var(--rt-blue); margin-right:10px; }
  h2 { margin:0 0 12px; font-size:15px; font-weight:700; } .workspace { display:grid; grid-template-columns:244px minmax(0,1fr) 238px; background:var(--rt-surface); border:1px solid var(--rt-line); border-radius:10px; overflow:hidden; } .controls { padding:20px 18px; border-right:1px solid var(--rt-line); } .control-section { padding-bottom:20px; margin-bottom:20px; border-bottom:1px solid var(--rt-line); } .section-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; } .unit { font:10px var(--rt-mono); color:var(--rt-muted); } .source-tabs,.segmented { display:flex; padding:3px; background:var(--rt-paper); gap:3px; border-radius:6px; margin-bottom:12px; } .source-tabs button,.segmented button { flex:1; border:0; padding:7px 4px; font-size:13px; background:transparent; border-radius:4px; } .source-tabs .active,.segmented .active { background:var(--rt-surface); color:var(--rt-blue); box-shadow:0 1px 3px #00000012; font-weight:700; } .gesture-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; } .gesture-grid button { font-size:14px; padding:8px 4px; border:1px solid var(--rt-line); background:transparent; border-radius:5px; } .gesture-grid button.active { color:var(--rt-blue); border-color:var(--rt-blue); background:color-mix(in srgb,var(--rt-blue) 7%,transparent); } .transport { display:flex; align-items:center; gap:7px; margin:15px 0; } .transport button { display:flex; align-items:center; gap:4px; font-size:12px; border:0; background:transparent; padding:0; white-space:nowrap; } .transport input { width:0; flex:1; } output,.transport output { font:11px var(--rt-mono); color:var(--rt-muted); white-space:nowrap; } .slider-row { display:grid; grid-template-columns:1fr auto; gap:5px; font-size:13px; margin-top:13px; } input[type=range] { width:100%; grid-column:1/-1; accent-color:var(--rt-blue); height:18px; } .check-row { display:flex; align-items:center; gap:8px; font-size:13px; margin:12px 0; } input[type=checkbox] { accent-c